{
  "folder": "trays",
  "schema": {
    "type": "obj",
    "fields": {
      "title": {
        "type": "text",
        "optional": true
      },
      "desc": {
        "type": "text",
        "optional": true
      },
      "menuThreshold": {
        "type": "int",
        "min": 1,
        "optional": true,
        "about": "@kind.tray.schema.fields.menuThreshold.about"
      },
      "values": {
        "type": "list",
        "of": {
          "type": "str",
          "pattern": "^#?(?:@?[a-z][a-z0-9-]*/)?[A-Za-z0-9][A-Za-z0-9-]*$",
          "reference": "circuit/part"
        }
      },
      "menus": {
        "type": "list",
        "of": {
          "type": "obj",
          "fields": {
            "id": {
              "type": "str",
              "pattern": "^(?:@?[a-z][a-z0-9-]*/)?[A-Za-z0-9][A-Za-z0-9-]*$",
              "reference": "menu"
            },
            "title": {
              "type": "text"
            },
            "values": {
              "type": "list",
              "of": {
                "type": "str",
                "pattern": "^#?(?:@?[a-z][a-z0-9-]*/)?[A-Za-z0-9][A-Za-z0-9-]*$",
                "reference": "circuit/part"
              }
            }
          }
        },
        "optional": true
      }
    }
  },
  "studio": {
    "name": "@kind.tray.name",
    "icon": "LayoutGrid"
  },
  "declares": "package",
  "overrides": {
    "package": [
      "*"
    ],
    "game": [
      "$text"
    ]
  }
}
