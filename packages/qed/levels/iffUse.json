    {
      "id": "iffUse-2",
      "kind": "logic/proof",
      "step": "@level.iffUse.tasks.iffUse-2.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "¬A"
          },
          "goal": "¬B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "hint": [
        "@level.iffUse.tasks.iffUse-2.hint.0"
      ],
      "solution": [
        "f = impI[A=B](body: m2) {",
        "  body {",
        "    m1 = mp(e.right, f.body)",
        "    m2 = mp(q, m1)",
        "  }",
        "}",
        "e = andE(p)",
        "goal <- f"
      ]
    }
