{
  "title": "@level.in-itsum.title",
  "tray": "prover",
  "intro": [{ "t": "@level.in-itsum.intro.0.t" }],
  "tasks": [
    {
      "id": "in-itsum-1",
      "kind": "logic/define",
      "words": ["everyday", "terms"],
      "step": "@level.in-itsum.tasks.in-itsum-1.step",
      "fn": "sum",
      "on": 0,
      "defs": ["plus"],
      "rows": [
        { "lhs": "sum(nil)", "choices": ["zero", "s(zero)"] },
        { "lhs": "sum(cons(x, xs))", "choices": ["plus(x, sum(xs))", "sum(xs)", "plus(x, sum(cons(x, xs)))"] }
      ],
      "tests": [
        { "term": "sum(cons(s(zero), cons(s(s(zero)), nil)))", "value": "s(s(s(zero)))" },
        { "term": "sum(nil)", "value": "zero" }
      ],
      "solution": ["zero", "plus(x, sum(xs))"],
      "naive": ["zero", "sum(xs)"],
      "brief": "@level.in-itsum.tasks.in-itsum-1.brief",
      "hint": ["@level.in-itsum.tasks.in-itsum-1.hint.0"],
      "intro": [{ "t": "@level.in-itsum.tasks.in-itsum-1.intro.0.t" }]
    },
    {
      "id": "in-itsum-2",
      "kind": "logic/define",
      "words": ["everyday", "terms"],
      "step": "@level.in-itsum.tasks.in-itsum-2.step",
      "fn": "itsum",
      "on": 0,
      "defs": ["plus"],
      "rows": [
        { "lhs": "itsum(nil, y)", "choices": ["y", "zero"] },
        {
          "lhs": "itsum(cons(x, xs), y)",
          "choices": ["itsum(xs, plus(y, x))", "itsum(xs, y)", "itsum(cons(x, xs), plus(y, x))"]
        }
      ],
      "tests": [
        { "term": "itsum(cons(s(zero), cons(s(s(zero)), nil)), zero)", "value": "s(s(s(zero)))" },
        { "term": "itsum(nil, s(zero))", "value": "s(zero)" }
      ],
      "solution": ["y", "itsum(xs, plus(y, x))"],
      "naive": ["zero", "itsum(xs, plus(y, x))"],
      "brief": "@level.in-itsum.tasks.in-itsum-2.brief",
      "hint": ["@level.in-itsum.tasks.in-itsum-2.hint.0"],
      "intro": [{ "t": "@level.in-itsum.tasks.in-itsum-2.intro.0.t" }]
    },
    {
      "id": "in-itsum-3",
      "kind": "logic/machine",
      "want": "logic/proved",
      "inputs": [{ "name": "in", "label": "@level.in-itsum.tasks.in-itsum-3.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": "@level.in-itsum.tasks.in-itsum-3.step",
      "types": ["list"],
      "defs": ["plus", "sum", "itsum"],
      "tests": [{ "goal": "∀xs. ∀y. itsum(xs, y) = plus(y, sum(xs))" }],
      "brief": "@level.in-itsum.tasks.in-itsum-3.brief",
      "hint": ["@level.in-itsum.tasks.in-itsum-3.hint.0", "@level.in-itsum.tasks.in-itsum-3.hint.1"],
      "solution": [
        "c0 = logic/directBackward-math[use=[\"list.induct\"]](in)",
        "c1 = proof-kit/each(c0, body: c4) {",
        "  body {",
        "    c2 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c1.body)",
        "    c3 = proof-kit/repeat(c2, body: c3_body) {",
        "      body {",
        "        c3_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c3.body)",
        "        c3_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c3.body)",
        "        c3_body_r3 = logic/directRewrite-math[use=[\"def.2\"]](c3.body)",
        "        c3_body_r4 = logic/directRewrite-math[use=[\"def.3\"]](c3.body)",
        "        c3_body_r5 = logic/directRewrite-math[use=[\"def.4\"]](c3.body)",
        "        c3_body_r6 = logic/directRewrite-math[use=[\"def.5\"]](c3.body)",
        "        c3_body_r7 = logic/directRewrite-math[use=[\"qed-math/addZero\"]](c3.body)",
        "        c3_body_r8 = logic/directRewrite-math[use=[\"qed-math/addAssoc\"]](c3.body)",
        "        c3_body_r9 = logic/directRewrite-logic_hyp[use=[\"hyp\"]](c3.body)",
        "        c3_body_g1 = proof-kit/append[ways=\"6\"](first: c3_body_r1, second: c3_body_r2, third: c3_body_r3, fourth: c3_body_r4, fifth: c3_body_r5, sixth: c3_body_r6)",
        "        c3_body = proof-kit/append[ways=\"4\"](first: c3_body_g1, second: c3_body_r7, third: c3_body_r8, fourth: c3_body_r9)",
        "      }",
        "    }",
        "    c4 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c3)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0 = logic/directBackward-math[use=[\"list.induct\"]](in)",
        "c1 = proof-kit/each(c0, body: c4) {",
        "  body {",
        "    c2 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c1.body)",
        "    c3 = proof-kit/repeat(c2, body: c3_body) {",
        "      body {",
        "        c3_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c3.body)",
        "        c3_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c3.body)",
        "        c3_body_r3 = logic/directRewrite-math[use=[\"def.2\"]](c3.body)",
        "        c3_body_r4 = logic/directRewrite-math[use=[\"def.3\"]](c3.body)",
        "        c3_body_r5 = logic/directRewrite-math[use=[\"def.4\"]](c3.body)",
        "        c3_body_r6 = logic/directRewrite-math[use=[\"def.5\"]](c3.body)",
        "        c3_body_r7 = logic/directRewrite-logic_hyp[use=[\"hyp\"]](c3.body)",
        "        c3_body_g1 = proof-kit/append[ways=\"6\"](first: c3_body_r1, second: c3_body_r2, third: c3_body_r3, fourth: c3_body_r4, fifth: c3_body_r5, sixth: c3_body_r6)",
        "        c3_body = proof-kit/append[ways=\"2\"](first: c3_body_g1, second: c3_body_r7)",
        "      }",
        "    }",
        "    c4 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c3)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
