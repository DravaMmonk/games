      },
      "params": {
        "type": "obj",
        "fields": {
          "letter": {
            "type": "oneOf",
            "values": [
              "T",
              "L",
              "X",
              "O",
              "F"
            ],
            "optional": true
          },
          "rows": {
            "type": "list",
            "of": {
              "type": "str",
              "pattern": "^[#.]+$"
            },
            "optional": true
          },
          "lo": {
            "type": "num",
            "optional": true
          },
          "hi": {
            "type": "num",
            "optional": true
          },
          "ox": {
            "type": "num",
            "optional": true
          },
          "oy": {
            "type": "num",
            "optional": true
          },
          "scale": {
            "type": "num",
            "optional": true
          },
          "size": {
            "type": "int",
            "min": 1,
            "about": {
              "zh": "边长（格）",
              "en": "the side, in cells"
            },
            "optional": true
          }
        }
      }
    },
