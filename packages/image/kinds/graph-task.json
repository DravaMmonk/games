{
  "extends": "task",
  "play": "image/graph",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "shape",
      "name": "image/task-unlocks"
    },
    "carries": {
      "type": "shape",
      "name": "image/carry-board"
    },
    "inputs": { "type": "list", "of": { "type": "str" }, "optional": true },
    "inputLabels": { "type": "map", "of": { "type": "text" }, "optional": true },
    "inputDescriptions": {
      "type": "map",
      "of": { "type": "text" },
      "about": "@kind.graph-task.fields.inputDescriptions.about",
      "optional": true
    },
    "outputs": { "type": "list", "of": { "type": "str" }, "optional": true },
    "outputLabels": { "type": "map", "of": { "type": "text" }, "optional": true },
    "views": {
      "type": "obj",
      "fields": {
        "in": { "type": "ref", "kind": "view", "optional": true },
        "out": { "type": "ref", "kind": "view", "optional": true },
        "mid": { "type": "ref", "kind": "view", "optional": true }
      },
      "about": "@kind.graph-task.fields.views.about",
      "optional": true
    },
    "check": {
      "type": "obj",
      "fields": {
        "tolerance": { "type": "num", "optional": true },
        "mismatches": { "type": "int", "min": 0, "optional": true }
      },
      "about": "@kind.graph-task.fields.check.about",
      "optional": true
    },
    "constraint": { "type": "call", "kind": "constraint", "optional": true },
    "trainRate": {
      "type": "num",
      "about": "@kind.graph-task.fields.trainRate.about",
      "optional": true
    },
    "trainRates": {
      "type": "list",
      "of": { "type": "num" },
      "about": "@kind.graph-task.fields.trainRates.about",
      "optional": true
    },
    "solution": {
      "type": "board",
      "optional": true
    },
    "naive": {
      "type": "board",
      "optional": true
    },
    "alsoFails": {
      "type": "list",
      "of": {
        "type": "board"
      },
      "about": "@kind.graph-task.fields.alsoFails.about",
      "optional": true
    }
  },
  "schema": {
    "type": "by",
    "field": "scene",
    "casesFrom": "image/scene"
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] },
  "caseGroups": "image/scene"
}
