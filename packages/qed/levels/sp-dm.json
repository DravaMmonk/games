      "hint": [
        "@level.sp-dm.tasks.sp-dm-2.hint.0"
      ],
      "solution": [
        "c1r0 = dm[use=[\"dm.notAll\"]]()",
        "c1 = rw(in, c1r0)",
        "c2r0 = dm[use=[\"dm.notEx\"]]()",
        "c2 = rw(in, c2r0)",
