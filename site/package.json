{
  "name": "games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ../games/kit/engine/package-imports.mjs node_modules/vite/bin/vite.js",
    "build": "npm run build:games",
    "build:game": "node --import ../games/kit/engine/package-imports.mjs node_modules/vite/bin/vite.js build --config vite.game.config.js",
    "lint": "eslint .",
    "words": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/words.mjs",
    "lint:kit": "cd .. && node --import ./games/kit/engine/package-imports.mjs site/node_modules/eslint/bin/eslint.js --config site/eslint.kit.config.js games/kit packages/*/core packages/*/view",
    "preview": "npm run preview:games",
    "preview:games": "node --import ../games/kit/engine/package-imports.mjs node_modules/vite/bin/vite.js preview --config vite.games.config.js",
    "figures": "node ../tools/figures.mjs",
    "check": "node ../tools/figures.mjs --check && node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/check.js",
    "deps": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/deps.js",
    "styles": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/styles.js",
    "new": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/scaffold.js",
    "new-game": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/scaffold.js game",
    "op": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/ops/cli.js",
    "mcp": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/ops/mcp.js",
    "studio": "node --import ../games/kit/engine/package-imports.mjs node_modules/vite/bin/vite.js --mode studio --open /studio.html",
    "build:games": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/app/build.mjs",
    "publish:content": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/app/content.mjs",
    "test": "node --import ../games/kit/engine/package-imports.mjs --test ../games/kit/engine/*.test.js ../games/kit/engine/ops/*.test.js ../games/kit/app/*.test.js ../games/kit/studio/*.test.js ../games/kit/shell/*.test.js ../games/kit/views/*.test.js ../games/kit/pipeline/*.test.js ../packages/*/test/*.test.js ../packages/circuit/test/*/*.test.js ../packages/circuit/test/*/*/*.test.js",
    "pipeline": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/pipeline/pipeline.mjs",
    "new-package": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/scaffold.js package",
    "baseline": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/baseline.mjs",
    "publish": "node --import ../games/kit/engine/package-imports.mjs ../games/kit/engine/releases.js",
    "test:zero": "node --import ../games/kit/engine/package-imports.mjs zero-content.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "marked-katex-extension": "^5.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.65.1",
    "vite": "^7.2.4"
  }
}
