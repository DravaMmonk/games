{
  "title": "@level.s-search.title",
  "adds": [
    "search"
  ],
  "tray": "machine",
  "intro": [
    {
      "t": "@level.s-search.intro.0.t"
    },
    {
      "t": "@level.s-search.intro.1.t"
    }
  ],
  "after": "@level.s-search.after",
  "tasks": [
    {
      "id": "s-search",
      "kind": "logic/machine",
      "want": "logic/proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.s-search.tasks.s-search.inputs.0.label"
        }
      ],
      "backtrack": true,
      "tests": [
        {
          "goal": "Slip",
          "hyps": [
            "Rain → Slip",
            "Wet → Slip",
            "Wind → Wet",
            "Wind"
          ]
        },
        {
          "goal": "(Rain → Wet) → ((Wet → Slip) → ((Slip → Fall) → (Rain → Fall)))"
        },
        {
          "goal": "(Wind → Slip) → ((Rain → Slip) → ((Wet → Rain) → (Wet → Slip)))"
        }
      ],
      "brief": "@level.s-search.tasks.s-search.brief",
      "hint": [
        "@level.s-search.tasks.s-search.hint.0",
        "@level.s-search.tasks.s-search.hint.1",
        "@level.s-search.tasks.s-search.hint.2"
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c2 = assumption(c0.body)",
        "    c3r0 = impI()",
        "    c3 = rule(c0.body, c3r0)",
        "    c4r0 = mp[use=[mp]]()",
        "    c5 = rule(c0.body, c4r0)",
        "    c4 = assumption(c5)",
        "    c1 = append[ways=\"3\"](first: c2, second: c3, third: c4)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c2 = assumption(c0.body)",
        "    c3r0 = impI()",
        "    c3 = rule(c0.body, c3r0)",
        "    c4r0 = mp[use=[mp]]()",
        "    c4 = rule(c0.body, c4r0)",
        "    c1 = append[ways=\"3\"](first: c2, second: c3, third: c4)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
