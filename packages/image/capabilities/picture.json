      },
      "params": {
        "type": "obj",
        "fields": {
          "seed": {
            "type": "int"
          },
          "dark": {
            "type": "num"
          },
          "bright": {
            "type": "num"
          },
          "disc": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "min": 3,
            "about": {
              "zh": "圆：cx, cy, 半径的平方",
              "en": "a disc: cx, cy, the radius squared"
            },
            "optional": true
          },
          "rightOf": {
            "type": "int",
            "about": {
              "zh": "这一列右边",
              "en": "right of this column"
            },
            "optional": true
          },
          "stripes": {
            "type": "list",
            "of": {
              "type": "int"
            },
            "min": 2,
            "about": {
              "zh": "斜纹：(x + y) 除以 period 的余数小于 width",
              "en": "slanted stripes: (x + y) mod period under width"
            },
            "optional": true
          }
        }
      }
