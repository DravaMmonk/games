            "state-graph/way": {
              "n": 1,
              "sensor": "up"
            }
          },
          {
            "state-graph/way": {
              "n": 2,
              "sensor": "left"
            }
          },
          {
            "state-graph/start": {
              "sensor": "start"
            }
          }
        ],
        "facts": [
          "start"
        ]
      }
    }
  ],
  "inputs": [
    {
      "name": "up",
      "type": "kernel/number"
    },
    {
      "name": "left",
      "type": "kernel/number"
    },
    {
      "name": "start",
      "type": "kernel/boolean"
    }
  ],
  "outputType": "kernel/number"
