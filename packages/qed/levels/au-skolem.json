{
  "title": "@level.au-skolem.title",
  "adds": [
    "skolem"
  ],
  "local": [
    "skolem"
  ],
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "after": "@level.au-skolem.after",
  "intro": [
    {
      "t": "@level.au-skolem.intro.0.t"
    },
    { "t": "@level.au-skolem.intro.1.t" }
  ],
  "tasks": [
    {
      "id": "au-skolem",
      "kind": "logic/machine",
      "want": "logic/becomes",
      "brief": "@level.au-skolem.tasks.au-skolem.brief",
      "hint": [
        "@level.au-skolem.tasks.au-skolem.hint.0",
        "@level.au-skolem.tasks.au-skolem.hint.1"
      ],
      "tests": [
        {
          "goal": "⊥",
          "hyps": [
            "Rain → Wet",
            "Rain",
            "¬Wet"
          ],
          "becomes": [
            [
              "¬Rain ∨ Wet; Rain; ¬Wet ⊢ ⊥"
            ]
          ]
        },
        {
          "goal": "⊥",
          "hyps": [
            "Bus ∨ (Bike ∧ Rain)",
            "¬(Bus → OnTime)"
          ],
          "becomes": [
            [
              "(Bus ∨ Bike) ∧ (Bus ∨ Rain); Bus ∧ ¬OnTime ⊢ ⊥"
            ]
          ]
        },
        {
          "goal": "⊥",
          "hyps": [
            "KA ↔ ¬KB",
            "¬¬KA"
          ],
          "becomes": [
            [
              "(¬KA ∨ ¬KB) ∧ (KB ∨ KA); KA ⊢ ⊥"
            ]
          ]
        },
        {
          "goal": "⊥",
          "hyps": [
            "∀x. Bird(x) → Flies(x)",
            "¬∀x. Bird(x) → Flies(x)"
          ],
          "becomes": [
            [
              "⋀a. ∀x. ¬Bird(x) ∨ Flies(x); Bird(a) ∧ ¬Flies(a) ⊢ ⊥"
            ]
          ]
        },
        {
          "goal": "⊥",
          "hyps": [
            "∀x. ∃y. Parent(y, x)"
          ],
          "becomes": [
            [
              "∀x. Parent(sk1(x), x) ⊢ ⊥"
            ]
          ]
        },
        {
          "goal": "⊥",
          "hyps": [
            "Human(h)",
            "¬∀x. ∃y. Likes(y, x)"
          ],
          "becomes": [
            [
              "⋀a. Human(h); ∀y. ¬Likes(y, a) ⊢ ⊥"
            ]
          ]
        }
      ],
      "solution": [
        "a = cnf[at=hyps](in)",
        "b = skolem(a)",
        "out <- b"
      ],
      "naive": [
        "a = cnf(in)",
        "b = skolem(a)",
        "out <- b"
      ]
    }
  ]
}
