        { "label": "(-1, 3, 1)", "s": [-1, 3, 1] },
        { "label": "(1, -2, 2)", "s": [1, -2, 2] }
      ],
      "hidden": [
        { "label": "(5, -3, 0)", "s": [5, -3, 0] },
        { "label": "(-2, -2, -1)", "s": [-2, -2, -1] }
      ],
      "solution": [
        "ex = exp(sx)",
        "eo = exp(so)",
        "ep = exp(sp)",
        "s1 = arith[op=add](ex, eo)",
        "s2 = arith[op=add](s1, ep)",
        "qx = arith[op=div](ex, s2)",
        "qo = arith[op=div](eo, s2)",
        "qp = arith[op=div](ep, s2)",
        "px <- qx",
        "po <- qo",
        "pp <- qp"
      ],
      "naive": [
        "s1 = arith[op=add](sx, so)",
        "s2 = arith[op=add](s1, sp)",
        "qx = arith[op=div](sx, s2)",
        "qo = arith[op=div](so, s2)",
        "qp = arith[op=div](sp, s2)",
        "px <- qx",
        "po <- qo",
        "pp <- qp"
      ]
    }
  ]
