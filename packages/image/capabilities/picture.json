      },
      "params": {
        "type": "obj",
        "fields": {
          "period": {
            "type": "num"
          },
          "angle": {
            "type": "num"
          },
          "size": {
            "type": "int",
            "min": 1,
            "about": {
              "zh": "边长（格）",
              "en": "the side, in cells"
            },
            "optional": true
          }
        }
      }
    },
