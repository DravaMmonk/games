{
  "type": "obj",
  "fields": {
    "model": {
      "type": "oneOf",
      "values": [
        "vision-complete/stop"
      ]
    },
    "setup": {
      "type": "obj",
      "fields": {
        "degree": {
          "type": "int",
          "min": 1
        },
        "seed": {
          "type": "int"
        },
        "wave": {
          "type": "num",
          "about": "@shape.bench-stop.fields.setup.fields.wave.about"
        },
        "train": {
          "type": "int",
          "min": 1
        },
        "noise": {
          "type": "num"
        },
        "valid": {
          "type": "int",
          "min": 2
        },
        "rate": {
          "type": "num"
        }
      }
    },
    "cases": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "label": {
            "type": "text"
          }
        }
      },
      "min": 2,
      "optional": true
    },
    "stages": {
      "type": "shape",
      "name": "image/bench-stages"
    },
    "knobs": {
      "type": "shape",
      "name": "image/bench-knobs"
    }
  }
}
