{"id":"market","domain":"market","vocabulary":2,"title":{"zh":"看不见的手"},"kicker":{"zh":"经济学"},"lede":{"zh":"一家小店，每天进货，定一个价。先把一条街的买卖一块块搭出来，再搭一台只看自己货架就能找到价格的机器。"},"primitives":["mul","sub","min","const","div","add"],"concept":{"sub":"mul","div":"mul","add":"mul","min":"mul"},"eras":[{"id":0,"title":{"zh":"一家小店"},"question":{"zh":"价格定在哪里最合适，谁说了算？"},"foundation":["want","trade","clear","adjust","street"]}],"views":{"ticks":["terms","dots"]},"levels":[{"id":"adjust","title":{"zh":"往哪边调"},"intro":[{"t":{"zh":"店主不知道街上有多少人想买，只看得到昨天的结果：货剩了多少，多少人没买到。"}},{"t":{"zh":"这就够了。有人没买到，说明价格低了，该涨；有货剩下，说明价格高了，该降。差得多就多调，差得少就少调。"}}],"after":{"zh":"这条规则里没有「不要钱时想买」，也没有「每涨一块少」：它不需要知道需求。"},"adds":["add"],"builds":{"type":"pricer","name":{"zh":"调价器"},"desc":{"zh":"按昨天剩下的和没买到的调整价格。"}},"tasks":[{"id":"adjust","brief":{"zh":"今天的价格 = 昨天的价格 +（没买到 − 剩下）× 0.25。"},"inputs":[{"name":"was","label":{"zh":"昨天的价格"}},{"name":"left","label":{"zh":"剩下"}},{"name":"short","label":{"zh":"没买到"}}],"outputs":[{"name":"price","label":{"zh":"价格"}}],"tests":[{"in":{"was":10,"left":0,"short":20},"out":{"price":15}},{"in":{"was":25,"left":10,"short":0},"out":{"price":22.5}},{"in":{"was":20,"left":0,"short":0},"out":{"price":20}}],"hidden":[{"in":{"was":30,"left":4,"short":0},"out":{"price":29}},{"in":{"was":7,"left":0,"short":8},"out":{"price":9}}],"solution":["g = sub(short, left)","k = const[value=0.25]()","d = mul(g, k)","n = add(was, d)","price <- n"],"naive":["k = const[value=0.25]()","d = mul(short, k)","n = add(was, d)","price <- n"]}]},{"id":"clear","title":{"zh":"刚好卖完"},"intro":[{"t":{"zh":"有一个价格，想买的人正好和进的货一样多：没有剩，也没人空手。这个价格叫<wiki-ref to=\"clearing\"></wiki-ref>。"}},{"t":{"zh":"想买 = 进货，也就是「不要钱时想买」减「每涨一块少」乘价格，等于进货。把价格解出来。"}}],"after":{"zh":"出清价格 =（不要钱时想买 − 进货）÷ 每涨一块少。算它要知道整条街的需求，而店主每天看得到的只有自己的货架。"},"adds":["div"],"tasks":[{"id":"first","brief":{"zh":"这条街不要钱时 60 人想买，每涨一块少 2 人；店里每天进 20 件。定一个价，让每天刚好卖完。"},"outputs":[{"name":"price","label":{"zh":"价格"},"view":"dots"}],"tests":[{"shops":[{"stock":20,"top":60,"slope":2,"open":10}],"ticks":5}],"solution":["c = const[value=20]()","price <- c"]},{"id":"second","brief":{"zh":"换一条街：不要钱时 105 人想买，每涨一块少 3 人；每天进 15 件。"},"outputs":[{"name":"price","label":{"zh":"价格"},"view":"dots"}],"tests":[{"shops":[{"stock":15,"top":105,"slope":3,"open":10}],"ticks":5}],"solution":["c = const[value=30]()","price <- c"]},{"id":"clear","brief":{"zh":"让板替你算：给它一条街的三个数，它给出出清价格。"},"inputs":[{"name":"top","label":{"zh":"不要钱时想买"}},{"name":"slope","label":{"zh":"每涨一块少"}},{"name":"stock","label":{"zh":"进货"}}],"outputs":[{"name":"price","label":{"zh":"价格"}}],"tests":[{"in":{"top":60,"slope":2,"stock":20},"out":{"price":20}},{"in":{"top":105,"slope":3,"stock":15},"out":{"price":30}},{"in":{"top":40,"slope":4,"stock":12},"out":{"price":7}}],"hidden":[{"in":{"top":78,"slope":4,"stock":30},"out":{"price":12}},{"in":{"top":60,"slope":1,"stock":10},"out":{"price":50}}],"solution":["d = sub(top, stock)","p = div(d, slope)","price <- p"],"naive":["p = div(top, slope)","price <- p"]}]},{"id":"street","title":{"zh":"看不见的手"},"intro":[{"t":{"zh":"现在把调价器放到街上。街上的需求它一个数也读不到，每天只看得到昨天的价格、剩下的和没买到的。"}}],"after":{"zh":"没有人告诉它出清价格是多少，它一天天调，自己走到了那里；行情变了，它又跟过去。这种一步步试出来的办法叫<wiki-ref to=\"tatonnement\"></wiki-ref>。"},"tasks":[{"id":"street","brief":{"zh":"每条街开张 30 天。最后一天，剩下的和没买到的都要不到 1。"},"inputs":[{"name":"was","label":{"zh":"昨天的价格"}},{"name":"left","label":{"zh":"剩下"}},{"name":"short","label":{"zh":"没买到"}}],"outputs":[{"name":"price","label":{"zh":"价格"},"view":"dots"}],"tests":[{"shops":[{"stock":20,"top":60,"slope":2,"open":10}],"ticks":30},{"shops":[{"stock":15,"top":105,"slope":3,"open":10}],"ticks":30},{"shops":[{"stock":12,"top":40,"slope":4,"open":10}],"ticks":30}],"hidden":[{"shops":[{"stock":20,"top":47,"slope":2,"open":10}],"ticks":30},{"shops":[{"stock":30,"top":78,"slope":4,"open":10}],"ticks":30},{"shops":[{"stock":10,"top":60,"slope":1,"open":10}],"ticks":60}],"solution":["a = pricer(was, left, short)","price <- a"],"naive":["price <- was"]},{"id":"shift","brief":{"zh":"两家店各定各的价，行情中途会变。60 天后，两家都要出清。"},"inputs":[{"name":"was1","label":{"zh":"甲店昨天的价格"}},{"name":"left1","label":{"zh":"甲店剩下"}},{"name":"short1","label":{"zh":"甲店没买到"}},{"name":"was2","label":{"zh":"乙店昨天的价格"}},{"name":"left2","label":{"zh":"乙店剩下"}},{"name":"short2","label":{"zh":"乙店没买到"}}],"outputs":[{"name":"price1","label":{"zh":"甲店价格"},"view":"dots"},{"name":"price2","label":{"zh":"乙店价格"},"view":"dots"}],"tests":[{"shops":[{"stock":20,"top":60,"slope":2,"open":10,"shifts":[{"at":20,"top":80}]},{"stock":15,"top":105,"slope":3,"open":10,"shifts":[{"at":30,"top":75}]}],"ticks":60}],"hidden":[{"shops":[{"stock":30,"top":78,"slope":4,"open":10,"shifts":[{"at":15,"top":110}]},{"stock":10,"top":60,"slope":1,"open":10,"shifts":[{"at":25,"top":40}]}],"ticks":60}],"solution":["a = pricer(was1, left1, short1)","b = pricer(was2, left2, short2)","price1 <- a","price2 <- b"],"naive":["price1 <- was1","price2 <- was2"]},{"id":"break","brief":{"zh":"这块调价器只会涨：今天 = 昨天 + 没买到 × 0.25，货剩下它不管。开张前的价格是 10。给它一条街：好的调价器 30 天后出清，它却不能。"},"outputs":[{"name":"stock","label":{"zh":"进货"}},{"name":"top","label":{"zh":"不要钱时想买"}},{"name":"slope","label":{"zh":"每涨一块少"}}],"tests":[{"breaks":"adjust","ticks":30,"open":10}],"withhold":["mul","sub","min","demand","div","add","pricer"],"solution":["a = const[value=20]()","b = const[value=30]()","c = const[value=2]()","stock <- a","top <- b","slope <- c"],"naive":["a = const[value=20]()","b = const[value=60]()","c = const[value=2]()","stock <- a","top <- b","slope <- c"]}]},{"id":"trade","title":{"zh":"一天的买卖"},"intro":[{"t":{"zh":"店里每天进一批货。想买的人比货少，货就剩下；想买的人比货多，就有人空手回去。"}},{"t":{"zh":"卖出去的，是「想买」和「进货」里小的那个。<part-ref to=\"part:min\"></part-ref>给出两个数里小的。"}}],"after":{"zh":"剩下的和没买到的不会同时出现：货不够时没有剩，货有剩时没人空手。"},"adds":["const","min"],"tasks":[{"id":"count","brief":{"zh":"先自己算一次。这条街不要钱时 60 人想买，每涨一块少 2 人；今天卖 25 块，进了 20 件。卖出多少，剩下多少，多少人没买到？"},"outputs":[{"name":"sold","label":{"zh":"卖出"}},{"name":"left","label":{"zh":"剩下"}},{"name":"short","label":{"zh":"没买到"}}],"tests":[{"given":{"top":60,"slope":2,"price":25,"stock":20},"answer":{"sold":10,"left":10,"short":0}}],"withhold":["mul","sub","min","demand"],"starter":["a = const[value=0]()","b = const[value=0]()","c = const[value=0]()","sold <- a","left <- b","short <- c"],"solution":["a = const[value=10]()","b = const[value=10]()","c = const[value=0]()","sold <- a","left <- b","short <- c"]},{"id":"trade","brief":{"zh":"算出这一天卖出多少、剩下多少、多少人没买到。剩下 = 进货 − 卖出；没买到 = 想买 − 卖出。"},"inputs":[{"name":"top","label":{"zh":"不要钱时想买"}},{"name":"slope","label":{"zh":"每涨一块少"}},{"name":"price","label":{"zh":"价格"}},{"name":"stock","label":{"zh":"进货"}}],"outputs":[{"name":"sold","label":{"zh":"卖出"}},{"name":"left","label":{"zh":"剩下"}},{"name":"short","label":{"zh":"没买到"}}],"tests":[{"in":{"top":60,"slope":2,"price":20,"stock":20},"out":{"sold":20,"left":0,"short":0}},{"in":{"top":60,"slope":2,"price":10,"stock":20},"out":{"sold":20,"left":0,"short":20}},{"in":{"top":60,"slope":2,"price":25,"stock":20},"out":{"sold":10,"left":10,"short":0}}],"hidden":[{"in":{"top":105,"slope":3,"price":25,"stock":15},"out":{"sold":15,"left":0,"short":15}},{"in":{"top":40,"slope":4,"price":8,"stock":12},"out":{"sold":8,"left":4,"short":0}}],"solution":["w = demand(top, slope, price)","s = min(w, stock)","l = sub(stock, s)","h = sub(w, s)","sold <- s","left <- l","short <- h"],"naive":["w = demand(top, slope, price)","l = sub(stock, w)","h = sub(w, w)","sold <- w","left <- l","short <- h"]}]},{"id":"want","title":{"zh":"想买的人"},"intro":[{"t":{"zh":"一条街上想买的人有多少，看价格。价格越高，想买的人越少，这就是<wiki-ref to=\"demand\"></wiki-ref>。"}},{"t":{"zh":"最简单的一种：不要钱时有一批人想买，价格每涨一块，就少固定的几个人。"}}],"after":{"zh":"三个数就说清了一条街：不要钱时多少人想买，每涨一块少几个，现在卖多少钱。"},"adds":["mul","sub"],"builds":{"type":"demand","name":{"zh":"需求"},"desc":{"zh":"按价格给出想买的人数。"}},"tasks":[{"id":"want","brief":{"zh":"算出想买的人数：从「不要钱时想买」里，减去「每涨一块少」乘「价格」。"},"inputs":[{"name":"top","label":{"zh":"不要钱时想买"}},{"name":"slope","label":{"zh":"每涨一块少"}},{"name":"price","label":{"zh":"价格"}}],"outputs":[{"name":"wanted","label":{"zh":"想买"}}],"tests":[{"in":{"top":60,"slope":2,"price":10},"out":{"wanted":40}},{"in":{"top":60,"slope":2,"price":20},"out":{"wanted":20}},{"in":{"top":105,"slope":3,"price":30},"out":{"wanted":15}}],"hidden":[{"in":{"top":40,"slope":4,"price":7},"out":{"wanted":12}},{"in":{"top":78,"slope":4,"price":12},"out":{"wanted":30}}],"solution":["m = mul(slope, price)","w = sub(top, m)","wanted <- w"],"naive":["w = sub(top, price)","wanted <- w"]}]}],"glossary":{"groups":[{"id":"market","title":{"zh":"市场"}}],"entries":[{"id":"demand","group":"market","title":{"zh":"需求"},"at":"want","body":[{"zh":"在某个价格下，人们想买的数量。价格越高，想买的通常越少。"}]},{"id":"clearing","group":"market","title":{"zh":"出清价格"},"at":"clear","body":[{"zh":"在这个价格下，想买的数量正好等于要卖的数量：货卖完了，也没有人空手而归。价格比它高，货会剩下；比它低，有人买不到。"}],"see":["demand"]},{"id":"tatonnement","group":"market","title":{"zh":"试错调价"},"at":"street","body":[{"zh":"不去算出清价格，只看结果调：想买的比货多就涨价，货比想买的多就降价，差多少调多少。经济学里称为试错过程（tâtonnement）。"}],"see":["clearing"]}]}}