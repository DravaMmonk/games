{
  "extends": "benchModel",
  "items": {
    "racer": {
      "about": "@capability.benchModel.items.racer.about",
      "shape": "vision-complete/bench-racer",
      "params": {
        "type": "obj",
        "fields": {
          "kernels": {
            "type": "list",
            "of": {
              "type": "obj",
              "fields": {
                "id": {
                  "type": "str"
                },
                "cells": {
                  "type": "list",
                  "of": {
                    "type": "num"
                  },
                  "min": 9,
                  "view": "grid"
                },
                "div": {
                  "type": "num"
                }
              }
            },
            "about": "@capability.benchModel.items.racer.params.fields.kernels.about"
          },
          "inputs": {
            "type": "list",
            "of": {
              "type": "call",
              "kind": "picture"
            }
          },
          "rounds": {
            "type": "int",
            "min": 1
          },
          "minGap": {
            "type": "num"
          },
          "time": {
            "type": "obj",
            "fields": {
              "start": {
                "type": "num"
              },
              "step": {
                "type": "num"
              },
              "min": {
                "type": "num"
              }
            },
            "about": "@capability.benchModel.items.racer.params.fields.time.about"
          }
        }
      }
    },
    "sum": {
      "about": "@capability.benchModel.items.sum.about",
      "shape": "vision-complete/bench-sum",
      "params": {
        "type": "obj",
        "fields": {
          "N": {
            "type": "int",
            "min": 2
          },
          "ks": {
            "type": "list",
            "of": {
              "type": "int"
            }
          }
        }
      },
      "stage": {
        "type": "obj",
        "fields": {
          "target": {
            "type": "list",
            "of": {
              "type": "num"
            }
          }
        }
      }
    },
    "probe": {
      "about": "@capability.benchModel.items.probe.about",
      "shape": "vision-complete/bench-probe",
      "params": {
        "type": "obj",
        "fields": {
          "N": {
            "type": "int",
            "min": 2
          },
          "wave": {
            "type": "obj",
            "fields": {
              "k": {
                "type": "int"
              },
              "A": {
                "type": "num"
              }
            },
            "about": "@capability.benchModel.items.probe.params.fields.wave.about"
          }
        }
      },
      "stage": {
        "type": "obj",
        "fields": {
          "kind": {
            "type": "oneOf",
            "values": [
              "find",
              "read",
              "blind",
              "combine"
            ],
            "about": "@capability.benchModel.items.probe.stage.fields.kind.about"
          },
          "input": {
            "type": "obj",
            "fields": {
              "c": {
                "type": "num"
              },
              "waves": {
                "type": "list",
                "of": {
                  "type": "obj",
                  "fields": {
                    "k": {
                      "type": "int"
                    },
                    "A": {
                      "type": "num"
                    },
                    "shift": {
                      "type": "num",
                      "optional": true
                    }
                  }
                }
              }
            },
            "optional": true
          },
          "checks": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "about": "@capability.benchModel.items.probe.stage.fields.checks.about",
            "optional": true
          },
          "answers": {
            "type": "str",
            "about": "@capability.benchModel.items.probe.stage.fields.answers.about"
          }
        }
      }
    },
    "alias": {
      "about": "@capability.benchModel.items.alias.about",
      "shape": "vision-complete/bench-alias",
      "params": {
        "type": "obj",
        "fields": {
          "fine": {
            "type": "int",
            "min": 2
          },
          "folds": {
            "type": "list",
            "of": {
              "type": "list",
              "of": {
                "type": "int"
              },
              "min": 3
            },
            "about": "@capability.benchModel.items.alias.params.fields.folds.about"
          }
        }
      },
      "stage": {
        "type": "obj",
        "fields": {
          "samples": {
            "type": "int",
            "optional": true
          },
          "reference": {
            "type": "obj",
            "fields": {
              "c": {
                "type": "num"
              },
              "A": {
                "type": "num"
              },
              "k": {
                "type": "int"
              },
              "phase": {
                "type": "num"
              }
            },
            "optional": true
          },
          "wave": {
            "type": "obj",
            "fields": {
              "c": {
                "type": "num"
              },
              "A": {
                "type": "num"
              },
              "k": {
                "type": "int"
              },
              "phase": {
                "type": "num"
              }
            },
            "optional": true
          },
          "parts": {
            "type": "list",
            "of": {
              "type": "obj",
              "fields": {
                "k": {
                  "type": "int"
                },
                "A": {
                  "type": "num"
                },
                "phase": {
                  "type": "num"
                }
              }
            },
            "optional": true
          },
          "answers": {
            "type": "str",
            "about": "@capability.benchModel.items.alias.stage.fields.answers.about"
          }
        }
      }
    },
    "stop": {
      "about": "@capability.benchModel.items.stop.about",
      "shape": "vision-complete/bench-stop",
      "params": {
        "type": "obj",
        "fields": {
          "degree": {
            "type": "int",
            "min": 1
          },
          "seed": {
            "type": "int"
          },
          "wave": {
            "type": "num",
            "about": "@capability.benchModel.items.stop.params.fields.wave.about"
          },
          "train": {
            "type": "int",
            "min": 1
          },
          "noise": {
            "type": "num"
          },
          "valid": {
            "type": "int",
            "min": 2
          },
          "rate": {
            "type": "num"
          }
        }
      }
    },
    "contrast": {
      "about": "@capability.benchModel.items.contrast.about",
      "shape": "vision-complete/bench-contrast",
      "params": {
        "type": "obj",
        "fields": {
          "names": {
            "type": "list",
            "of": {
              "type": "str"
            }
          },
          "base": {
            "type": "list",
            "of": {
              "type": "call",
              "kind": "picture"
            }
          },
          "tau": {
            "type": "num"
          },
          "rate": {
            "type": "num"
          },
          "testSeeds": {
            "type": "list",
            "of": {
              "type": "int"
            }
          }
        }
      }
    },
    "hough": {
      "about": "@capability.benchModel.items.hough.about",
      "shape": "vision-complete/bench-hough",
      "params": {
        "type": "obj",
        "fields": {
          "rhoMax": {
            "type": "num"
          },
          "tol": {
            "type": "obj",
            "fields": {
              "theta": {
                "type": "num"
              },
              "rho": {
                "type": "num"
              }
            }
          }
        }
      },
      "case": {
        "type": "obj",
        "fields": {
          "seed": {
            "type": "int"
          },
          "lines": {
            "type": "list",
            "of": {
              "type": "obj",
              "fields": {
                "theta": {
                  "type": "num"
                },
                "rho": {
                  "type": "num"
                },
                "n": {
                  "type": "int"
                },
                "from": {
                  "type": "num",
                  "optional": true
                },
                "to": {
                  "type": "num",
                  "optional": true
                }
              }
            }
          },
          "outliers": {
            "type": "int"
          }
        }
      }
    },
    "ransac": {
      "about": "@capability.benchModel.items.ransac.about",
      "shape": "vision-complete/bench-ransac",
      "params": {
        "type": "obj",
        "fields": {
          "n": {
            "type": "int"
          },
          "sigma": {
            "type": "num"
          },
          "trials": {
            "type": "int"
          },
          "tol": {
            "type": "obj",
            "fields": {
              "theta": {
                "type": "num"
              },
              "rho": {
                "type": "num"
              }
            }
          },
          "solution": {
            "type": "obj",
            "fields": {
              "delta": {
                "type": "num"
              },
              "k": {
                "type": "list",
                "of": {
                  "type": "int"
                }
              }
            },
            "about": "@capability.benchModel.items.ransac.params.fields.solution.about"
          }
        }
      },
      "case": {
        "type": "obj",
        "fields": {
          "outliers": {
            "type": "num"
          },
          "budget": {
            "type": "int"
          }
        }
      }
    },
    "cover": {
      "about": "@capability.benchModel.items.cover.about",
      "shape": "vision-complete/bench-cover",
      "params": {
        "type": "obj",
        "fields": {
          "cover": {
            "type": "obj",
            "fields": {
              "w": {
                "type": "num"
              },
              "h": {
                "type": "num"
              }
            }
          },
          "photo": {
            "type": "obj",
            "fields": {
              "w": {
                "type": "num"
              },
              "h": {
                "type": "num"
              }
            }
          },
          "title": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "min": 4
          },
          "logo": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "min": 4
          },
          "quad": {
            "type": "list",
            "of": {
              "type": "list",
              "of": {
                "type": "num"
              },
              "min": 2
            },
            "min": 4
          },
          "clutter": {
            "type": "obj",
            "fields": {
              "note": {
                "type": "list",
                "of": {
                  "type": "list",
                  "of": {
                    "type": "num"
                  },
                  "min": 2
                },
                "min": 4
              },
              "paper": {
                "type": "list",
                "of": {
                  "type": "list",
                  "of": {
                    "type": "num"
                  },
                  "min": 2
                },
                "min": 4
              }
            }
          },
          "seed": {
            "type": "int"
          }
        }
      }
    },
    "gan": {
      "about": "@capability.benchModel.items.gan.about",
      "shape": "vision-complete/bench-gan",
      "params": {
        "type": "obj",
        "fields": {
          "n": {
            "type": "int",
            "min": 1
          },
          "mode": {
            "type": "num"
          },
          "width": {
            "type": "num"
          },
          "rateD": {
            "type": "num"
          },
          "start": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "min": 2
          },
          "good": {
            "type": "obj",
            "fields": {
              "dSteps": {
                "type": "int"
              },
              "gSteps": {
                "type": "int"
              },
              "gRate": {
                "type": "num"
              }
            },
            "about": "@capability.benchModel.items.gan.params.fields.good.about"
          }
        }
      }
    },
    "appleLight": {
      "about": "@capability.benchModel.items.appleLight.about",
      "shape": "vision-complete/bench-appleLight",
      "params": {
        "type": "obj",
        "fields": {
          "colours": {
            "type": "list",
            "of": {
              "type": "list",
              "of": {
                "type": "num"
              },
              "min": 3,
              "max": 3
            },
            "min": 2,
            "max": 2
          },
          "red": {
            "type": "int",
            "min": 0,
            "max": 1
          }
        }
      }
    },
    "separable": {
      "about": "@capability.benchModel.items.separable.about",
      "shape": "vision-complete/bench-separable",
      "stage": {
        "type": "obj",
        "fields": {
          "target": {
            "type": "oneOf",
            "values": [
              "shared",
              "different"
            ]
          }
        }
      }
    },
    "attentionRoles": {
      "about": "@capability.benchModel.items.attentionRoles.about",
      "shape": "vision-complete/bench-attentionRoles",
      "params": {
        "type": "obj",
        "fields": {
          "role": {
            "type": "oneOf",
            "values": [
              "query",
              "key",
              "value"
            ]
          }
        }
      }
    },
    "attentionTraining": {
      "about": "@capability.benchModel.items.attentionTraining.about",
      "shape": "vision-complete/bench-attentionTraining"
