{
  "extends": "task",
  "play": "image/board",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "shape",
      "name": "image/task-unlocks"
    },
    "carries": {
      "type": "shape",
      "name": "image/carry-board"
    },
    "bench": {
      "type": "by",
      "field": "model",
      "fields": {
        "actions": {
          "type": "list",
          "of": {
            "type": "either",
            "of": [
              {
                "type": "obj",
                "fields": {
                  "id": {
                    "type": "shape",
                    "name": "image/action-id"
                  },
                  "act": { "type": "str" },
                  "arg": { "type": "any", "optional": true },
                  "label": { "type": "text" },
                  "primary": { "type": "bool", "optional": true },
                  "icon": { "type": "oneOf", "values": ["reset"], "optional": true },
                  "repeat": { "type": "int", "min": 2, "optional": true },
                  "every": { "type": "int", "min": 1, "optional": true },
                  "always": {
                    "type": "bool",
                    "about": { "zh": "运行中也能按", "en": "can be pressed while a run goes on" },
                    "optional": true
                  }
                }
              },
              {
                "type": "obj",
                "fields": {
                  "id": {
                    "type": "shape",
                    "name": "image/action-id"
                  },
                  "reset": { "type": "list", "of": { "type": "str" } },
                  "label": { "type": "text" },
                  "icon": { "type": "oneOf", "values": ["reset"], "optional": true }
                }
              }
            ]
          },
          "optional": true
        },
        "goal": {
          "type": "shape",
          "name": "image/bench-goals"
        },
        "check": {
          "type": "oneOf",
          "values": ["live", "submit"],
          "about": {
            "zh": "目标怎样判：live 随旋钮实时判（默认）；submit 只在玩家按「检查」时判，在那之前目标的读数和画面里的结果都不显示，玩家要先想好再试",
            "en": "how the goal is judged: live as the knobs turn (the default); submit only when the player presses Check, the goal's readings and the result in the pictures hidden until then, so the player thinks before trying"
          },
          "optional": true
        },
        "win": { "type": "text", "optional": true },
        "status": { "type": "text", "optional": true },
        "layout": {
          "type": "obj",
          "fields": {
            "head": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "main": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              }
            },
            "side": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "foot": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "split": {
              "type": "oneOf",
              "values": ["even", "narrow", "wide"],
              "about": {
                "zh": "主卡和旁栏的宽：各半，旁栏窄（300–340px），旁栏宽（340–430px）",
                "en": "the main card against the side: half each, a narrow side (300–340px), a wide side (340–430px)"
              },
              "optional": true
            }
          }
        }
      },
      "casesFrom": "benchModel"
    }
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] },
  "caseGroups": "benchModel"
}
