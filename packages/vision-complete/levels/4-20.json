      "withholds": ["vision-complete/softmax"],
      "inputs": ["sx", "so", "sp"],
      "inputLabels": {
        "sx": "S1",
        "so": "S2",
        "sp": "S3"
      },
      "outputs": ["px", "po", "pp"],
      "outputLabels": {
        "px": "P1",
        "po": "P2",
        "pp": "P3"
