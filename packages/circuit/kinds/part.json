{
  "folder": "parts",
  "schema": {
    "type": "either",
    "of": [
      {
        "type": "obj",
        "fields": {
          "name": {
            "type": "text"
          },
          "desc": {
            "type": "shape",
            "name": "circuit/part-description"
          },
          "inputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "optional": true
          },
          "outputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "min": 2,
            "optional": true
          },
          "outputType": {
            "type": "ref",
            "kind": "valueType",
            "optional": true
          },
          "settings": {
            "type": "shape",
            "name": "circuit/inline-settings"
          },
          "rules": {
            "type": "shape",
            "name": "circuit/rules"
          },
          "checks": {
            "type": "shape",
            "name": "circuit/checks"
          },
          "regions": {
            "type": "list",
            "of": {
              "type": "obj",
              "fields": {
                "name": {
                  "type": "str",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "type": {
                  "type": "ref",
                  "kind": "valueType",
                  "optional": true
                },
                "label": {
                  "type": "text",
                  "optional": true
                },
                "opens": {
                  "type": "bool",
                  "optional": true
                },
                "closes": {
                  "type": "bool",
                  "optional": true
                },
                "gives": {
                  "type": "list",
                  "of": {
                    "type": "str",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "optional": true
                },
                "when": {
                  "type": "shape",
                  "name": "circuit/engine-expression",
                  "optional": true
                }
              }
            },
            "optional": true
          },
          "icon": {
            "type": "shape",
            "name": "circuit/optional-icon-name"
          },
          "family": {
            "type": "ref",
            "kind": "family"
          },
          "views": {
            "type": "shape",
            "name": "circuit/part-views"
          },
          "keeps": {
            "type": "obj",
            "fields": {
              "input": {
                "type": "str",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "register": {
                "type": "str",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "about": {
              "zh": "把这个输入存进设置 register 说的寄存器，下一拍起读得到（held）；存的件不写 compute",
              "en": "keeps this input in the register its setting `register` names, readable from the next tick on (held); a keeping part writes no compute"
            },
            "optional": true
          },
          "op": {
            "type": "either",
            "of": [
              {
                "type": "ref",
                "kind": "operation"
              },
              {
                "type": "map",
                "of": {
                  "type": "ref",
                  "kind": "operation"
                }
              }
            ],
            "optional": true
          },
          "nulls": {
            "type": "oneOf",
            "values": [
              "give",
              "pass"
            ],
            "about": {
              "zh": "give：任何输入是「—」就给「—」（默认）；pass：交给运算",
              "en": "give: 「—」 at any input gives 「—」 (default); pass: the resources see it"
            },
            "optional": true
          }
        }
      },
      {
        "type": "obj",
        "fields": {
          "name": {
            "type": "text"
          },
          "desc": {
            "type": "shape",
            "name": "circuit/part-description"
          },
          "inputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "optional": true
          },
          "outputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "min": 2,
            "optional": true
          },
          "outputType": {
            "type": "ref",
            "kind": "valueType",
            "optional": true
          },
          "inside": {
            "type": "list",
            "of": {
              "type": "obj",
              "fields": {
                "id": {
                  "type": "str",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "form": {
                  "type": "str",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "optional": true
                },
                "label": {
                  "type": "str",
                  "about": {
                    "zh": "这种形态在元件上叫什么",
                    "en": "what this shape is called on the part"
                  },
                  "optional": true
                },
                "reference": {
                  "type": "obj",
                  "fields": {
                    "kind": {
                      "type": "any",
                      "optional": true
                    },
                    "play": {
                      "type": "any",
                      "optional": true
                    },
                    "solution": {
                      "type": "board",
                      "optional": true
                    },
                    "target": {
                      "type": "any",
                      "optional": true
                    },
                    "world": {
                      "type": "any",
                      "optional": true
                    },
                    "robot": {
                      "type": "any",
                      "optional": true
                    },
                    "ports": {
                      "type": "any",
                      "optional": true
                    },
                    "facts": {
                      "type": "any",
                      "optional": true
                    },
                    "dirs": {
                      "type": "any",
                      "optional": true
                    },
                    "filter": {
                      "type": "any",
                      "optional": true
                    },
                    "remember": {
                      "type": "any",
                      "optional": true
                    },
                    "noArm": {
                      "type": "any",
                      "optional": true
                    },
                    "want": {
                      "type": "any",
                      "optional": true
                    },
                    "in": {
                      "type": "any",
                      "optional": true
                    },
                    "out": {
                      "type": "any",
                      "optional": true
                    },
                    "axioms": {
                      "type": "any",
                      "optional": true
                    },
                    "rules": {
                      "type": "any",
                      "optional": true
                    },
                    "rule": {
                      "type": "any",
                      "optional": true
                    },
                    "goal": {
                      "type": "any",
                      "optional": true
                    },
                    "stated": {
                      "type": "any",
                      "optional": true
                    },
                    "defs": {
                      "type": "any",
                      "optional": true
                    },
                    "types": {
                      "type": "any",
                      "optional": true
                    },
                    "datatype": {
                      "type": "any",
                      "optional": true
                    },
                    "schema": {
                      "type": "any",
                      "optional": true
                    },
                    "inputs": {
                      "type": "any",
                      "optional": true
                    },
                    "outputs": {
                      "type": "any",
                      "optional": true
                    },
                    "tests": {
                      "type": "any",
                      "optional": true
                    }
                  },
                  "about": {
                    "zh": "可独立读取的参考作品和接口",
                    "en": "A standalone reference work and its interface"
                  }
                }
              }
            },
            "min": 1
          },
          "card": {
            "type": "ref",
            "kind": "operation",
            "about": {
              "zh": "不跑内部的作品，照这个引擎资源跑（它能做的比证出的更多）；内部仍说它是什么、在哪里得到",
              "en": "runs this engine resource instead of the work inside (it can do more than what was proved); the inside still says what the part is and where it is earned"
            },
            "optional": true
          },
          "settings": {
            "type": "shape",
            "name": "circuit/inline-settings"
          },
          "rules": {
            "type": "shape",
            "name": "circuit/rules"
          },
          "checks": {
            "type": "shape",
            "name": "circuit/checks"
          },
          "icon": {
            "type": "shape",
            "name": "circuit/icon-name"
          },
          "family": {
            "type": "ref",
            "kind": "family",
            "optional": true
          },
          "views": {
            "type": "shape",
            "name": "circuit/part-views"
          }
        }
      }
    ]
  },
  "relations": {
    "replaces": {
      "from": "circuit/part",
      "to": "circuit/part"
    }
  },
  "studio": {
    "name": "@kind.part.name",
    "icon": "Component"
  },
  "declares": "package",
  "overrides": {
    "package": [
      "*"
    ],
    "game": [
      "$text"
    ]
  }
}
