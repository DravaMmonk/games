{
  "name": "@part.value.name",
  "desc": "@part.value.desc",
  "inside": [
    {
      "id": "base",
      "reference": {
        "play": "state-graph/circuit",
        "solution": [
          "a = table/mmax(view.up, view.down, view.left)",
          "k = table/const[value=0.9]()",
          "b = table/mmax(a, view.right)",
          "x = table/mul(b, k)",
          "cell <- x"
        ],
        "world": "state-graph/vgrid",
        "robot": "state-graph/loop",
        "ports": [
          {
            "state-graph/way": {
              "n": 1,
              "sensor": "up"
            }
          },
          {
            "state-graph/way": {
              "n": 2,
              "sensor": "down"
            }
          },
          {
            "state-graph/way": {
              "n": 3,
              "sensor": "left"
            }
          },
          {
            "state-graph/way": {
              "n": 4,
              "sensor": "right"
            }
          }
        ]
      }
    }
  ],
  "settings": {
    "value": {
      "control": "number",
      "default": 0.9
    }
  },
  "inputs": [
    {
      "name": "up",
      "type": "kernel/number"
    },
    {
      "name": "down",
      "type": "kernel/number"
    },
    {
      "name": "left",
      "type": "kernel/number"
    },
    {
      "name": "right",
      "type": "kernel/number"
    }
  ],
  "outputType": "kernel/number"
}
