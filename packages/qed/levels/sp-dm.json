          "goal": "¬(Rain ∨ Wind) → Wet",
          "becomes": [
            [
              "¬Rain ∧ ¬Wind → Wet"
            ]
          ]
        },
        {
          "goal": "Wet ∧ ¬(Sat ∧ Sun)",
          "becomes": [
            [
              "Wet ∧ (¬Sat ∨ ¬Sun)"
            ]
          ]
        }
      ],
      "brief": "@level.sp-dm.tasks.sp-dm-1.brief",
      "hint": [
