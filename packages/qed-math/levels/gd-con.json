      "cases": [],
      "tests": [
        {
          "premises": { "d": "Prov(g) → Prov(gn)", "r": "Prov(g) → Prov(gp)", "con": "¬(Prov(gn) ∧ Prov(gp))" },
          "goal": "¬Prov(g)"
        }
      ],
      "brief": "@level.gd-con.tasks.gd-con.brief",
      "hint": ["@level.gd-con.tasks.gd-con.hint.0"],
      "solution": [
        "f = proof-kit/impI[A=\"Prov(g)\"](body: m3) {",
        "  body {",
        "    m1 = proof-kit/mp(d, f.body)",
        "    m2 = proof-kit/mp(r, f.body)",
        "    j = proof-kit/andI(m1, m2)",
        "    m3 = proof-kit/mp(con, j)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
