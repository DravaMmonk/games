        "@level.sp-dm.tasks.sp-dm-1.hint.1"
      ],
      "solution": [
        "c1r0 = dm[use=[\"dm.notOr\"]]()",
        "c1 = rw(in, c1r0)",
        "c2r0 = dm[use=[\"dm.notAnd\"]]()",
        "c2 = rw(in, c2r0)",
        "c0 = append(first: c1, second: c2)",
        "out <- c0"
      ]
    },
    {
