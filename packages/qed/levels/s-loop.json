{
  "title": "@level.s-loop.title",
  "adds": ["search"],
  "tray": "machine",
  "intro": [
    {
      "t": "@level.s-loop.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "s-loop",
      "kind": "logic/machine",
      "want": "logic/proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.s-loop.tasks.s-loop.inputs.0.label"
        }
      ],
      "backtrack": true,
      "rules": {
        "trans": {
          "name": "@level.s-loop.tasks.s-loop.rules.trans.name",
          "premises": [
            "Older(?x, ?y)",
            "Older(?y, ?z)"
          ],
          "conclusion": "Older(?x, ?z)"
        }
      },
      "tests": [
        {
          "goal": "Older(i, k)",
          "hyps": [
            "Older(i, j)",
            "Older(j, k)"
          ]
        },
        {
          "goal": "Older(j, l)",
          "hyps": [
            "Older(j, k)",
            "Older(k, l)"
          ]
        },
        {
          "goal": "Older(k, i)",
          "hyps": [
            "Older(i, j)",
            "Older(j, k)"
          ],
          "want": "logic/fails"
        }
      ],
      "brief": "@level.s-loop.tasks.s-loop.brief",
      "hint": [
        "@level.s-loop.tasks.s-loop.hint.0",
        "@level.s-loop.tasks.s-loop.hint.1"
      ],
      "solution": [
        "hypRule = logic/assumption()",
        "c0 = search[depth=\"3\"](in, body: c1) {",
        "  body {",
        "    c2 = rule(c0.body, hypRule)",
        "    c3r0 = trans()",
        "    c3 = rule(c0.body, c3r0)",
        "    c1 = append(first: c2, second: c3)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "hypRule = logic/assumption()",
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c2 = rule(c0.body, hypRule)",
        "    c3r0 = trans()",
        "    c3 = rule(c0.body, c3r0)",
        "    c1 = append(first: c2, second: c3)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
