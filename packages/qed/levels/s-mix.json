      "tests": [
        {
          "goal": "Rain → ((Rain → Wet) → Wet)"
        },
        {
          "goal": "(Rain → Wet) → ((Wet → Slip) → (Rain → Slip))"
        },
        {
          "goal": "Rain → (Wind → Rain)"
