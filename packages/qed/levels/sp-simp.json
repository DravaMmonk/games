{
  "title": "@level.sp-simp.title",
  "after": "@level.sp-simp.after",
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.sp-simp.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "sp-simp",
      "kind": "logic/machine",
      "want": "logic/becomes",
      "brief": "@level.sp-simp.tasks.sp-simp.brief",
      "hint": [
        "@level.sp-simp.tasks.sp-simp.hint.0"
      ],
      "tests": [
        {
          "goal": "Bright(i) ∧ Wind",
          "hyps": ["i = j", "Bright(j) ↔ Rain"],
          "becomes": [
            [
              "i = j; Bright(j) ↔ Rain ⊢ Rain ∧ Wind"
            ]
          ]
        },
        {
          "goal": "Rain ∨ Wet",
          "hyps": ["Rain ↔ Bright(i)", "i = j"],
          "becomes": [
            [
              "Rain ↔ Bright(i); i = j ⊢ Bright(j) ∨ Wet"
            ]
          ]
        },
        {
          "goal": "Likes(i, i) → Rain",
          "hyps": ["i = j"],
          "becomes": [
            [
              "i = j ⊢ Likes(j, j) → Rain"
            ]
          ]
        },
        {
          "goal": "Wind ∧ Wet",
          "hyps": ["Slip"],
          "becomes": [
            [
              "Slip ⊢ Wind ∧ Wet"
            ]
          ]
        }
      ],
      "solution": [
        "c0 = repeat(in, body: s2) {",
        "  body {",
        "    s1 = logic/directRewrite-qed_rewrite[use=[\"hyp.eq\"],at=goal-0](c0.body)",
        "    s2 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](s1)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "t1 = logic/directRewrite-qed_rewrite[use=[\"hyp.eq\"],at=goal-0](in)",
        "t2 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](t1)",
        "out <- t2"
      ],
      "publishes": [
        {
          "part": "simp",
          "variant": "base"
        }
      ]
    }
  ]
}
