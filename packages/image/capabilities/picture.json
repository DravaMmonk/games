    "radius": {
      "about": {
        "zh": "频率半径：每格离频谱中心（频率 (0, 0)）多远",
        "en": "the frequency radius: how far each cell is from the spectrum’s centre, frequency (0, 0)"
      },
      "params": {
        "type": "obj",
        "fields": {
          "size": {
            "type": "int",
            "min": 1,
            "about": {
              "zh": "边长（格）",
              "en": "the side, in cells"
            },
            "optional": true
          }
        }
      }
    },
    "offset": {
      "about": {
        "zh": "一张图每格加上 by（减 0.5 就是网络常用的居中）",
