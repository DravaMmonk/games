  "tasks": [
    {
      "id": "sort-if-1",
      "kind": "logic/machine",
      "want": "logic/proved",
      "inputs": [{ "name": "in", "label": "@level.sort-if.tasks.sort-if-1.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": "@level.sort-if.tasks.sort-if-1.step",
      "types": ["bool"],
      "defs": ["if"],
      "tests": [{ "goal": "∀u. ∀v. ∀w. u = tt → if(u, v, w) = v" }],
      "brief": "@level.sort-if.tasks.sort-if-1.brief",
      "hint": ["@level.sort-if.tasks.sort-if-1.hint.0", "@level.sort-if.tasks.sort-if-1.hint.1"],
      "solution": [
        "c0 = proof-kit/repeat(in, body: c1) {",
        "  body {",
        "    c1 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c0.body)",
        "  }",
        "}",
        "c2 = logic/directBackward-proof-kit_impI[use=[\"impI\"]](c0)",
        "c3 = proof-kit/repeat(c2, body: c3_body) {",
        "  body {",
        "    c3_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c3.body)",
        "    c3_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c3.body)",
        "    c3_body_r3 = logic/directRewrite-logic_hyp[use=[\"hyp\"]](c3.body)",
        "    c3_body = proof-kit/append[ways=\"3\"](first: c3_body_r1, second: c3_body_r2, third: c3_body_r3)",
        "  }",
        "}",
        "c4 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c3)",
        "out <- c4"
      ],
      "naive": [
        "c0 = proof-kit/repeat(in, body: c1) {",
        "  body {",
        "    c1 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c0.body)",
        "  }",
        "}",
        "c2 = logic/directBackward-proof-kit_impI[use=[\"impI\"]](c0)",
        "c3 = proof-kit/repeat(c2, body: c3_body) {",
        "  body {",
        "    c3_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c3.body)",
        "    c3_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c3.body)",
        "    c3_body = proof-kit/append[ways=\"2\"](first: c3_body_r1, second: c3_body_r2)",
        "  }",
        "}",
        "c4 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c3)",
        "out <- c4"
      ],
      "publishes": [{ "part": "qed-math/ifTrue", "variant": "base" }]
    },
