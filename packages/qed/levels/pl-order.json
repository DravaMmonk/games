{
  "title": "@level.pl-order.title",
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.pl-order.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "pl-order",
      "kind": "logic/machine",
      "want": "logic/answers",
      "backtrack": true,
      "rules": {
        "anc1": {
          "name": "@level.pl-order.tasks.pl-order.rules.anc1.name",
          "premises": [
            "Parent(?x, ?y)"
          ],
          "conclusion": "Anc(?x, ?y)"
        },
        "anc3": {
          "name": "@level.pl-order.tasks.pl-order.rules.anc3.name",
          "premises": [
            "Anc(?x, ?y)",
            "Parent(?y, ?z)"
          ],
          "conclusion": "Anc(?x, ?z)"
        }
      },
      "brief": "@level.pl-order.tasks.pl-order.brief",
      "hint": [
        "@level.pl-order.tasks.pl-order.hint.0",
        "@level.pl-order.tasks.pl-order.hint.1"
      ],
      "tests": [
        {
          "goal": "Anc(i, ?w)",
          "hyps": [
            "Parent(i, j)",
            "Parent(j, k)",
            "Parent(j, l)",
            "Parent(l, m)",
            "Parent(n, m)"
          ],
          "answers": [
            "j",
            "k",
            "l",
            "m"
          ]
        },
        {
          "goal": "Anc(j, ?w)",
          "hyps": [
            "Parent(i, j)",
            "Parent(j, k)",
            "Parent(j, l)",
            "Parent(l, m)",
            "Parent(n, m)"
          ],
          "answers": [
            "k",
            "l",
            "m"
          ]
        }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    cite = logic/directBackward-logic_assumption(c0.body)",
        "    one = logic/directBackward-anc1(c0.body)",
        "    more = logic/directBackward-anc3(c0.body)",
        "    fact = logic/directBackward-logic_assumption[at=goal-1](more)",
        "    c1 = append[ways=\"3\"](first: cite, second: one, third: fact)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    cite = logic/directBackward-logic_assumption(c0.body)",
        "    one = logic/directBackward-anc1(c0.body)",
        "    more = logic/directBackward-anc3(c0.body)",
        "    c1 = append[ways=\"3\"](first: cite, second: one, third: more)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
