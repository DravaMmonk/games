{
  "title": "@level.s-barbara.title",
  "intro": [
    {
      "t": "@level.s-barbara.intro.0.t"
    },
    {
      "t": "@level.s-barbara.intro.1.t"
    }
  ],
  "tasks": [
    {
      "id": "s-barbara",
      "kind": "logic/proof",
      "tests": [
        {
          "premises": {
            "p": "∀x. A(x) → B(x)",
            "q": "∀x. B(x) → C(x)"
          },
          "goal": "∀x. A(x) → C(x)"
        }
      ],
      "cases": [
        {
          "A": "Cat",
          "B": "Pet",
          "C": "Fluffy"
        },
        {
          "A": "Baby",
          "B": "Human",
          "C": "Mortal"
        }
      ],
      "hint": [
        "@level.s-barbara.tasks.s-barbara.hint.0"
      ],
      "solution": [
        "g = allI(body: h) {",
        "  body {",
        "    h = impI[A=\"A(a)\"](body: m2) {",
        "      body {",
        "        e1 = allE[t=a](p)",
        "        e2 = allE[t=a](q)",
        "        m1 = mp(e1, h.body)",
        "        m2 = mp(e2, m1)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ],
      "tray": "proof",
      "step": "@level.s-barbara.tasks.s-barbara.step",
      "after": "@level.s-barbara.tasks.s-barbara.after"
    },
    {
      "id": "s-carroll",
      "kind": "logic/proof",
      "tests": [
        {
          "premises": {
            "p": "∀x. A(x) → ¬B(x)",
            "q": "∀x. C(x) → D(x)",
            "r": "∀x. ¬B(x) → ¬D(x)"
          },
          "goal": "∀x. A(x) → ¬C(x)"
        }
      ],
      "cases": [
        {
          "A": "Baby",
          "B": "Logical",
          "C": "Tamer",
          "D": "Respected"
        }
      ],
      "hint": [
        "@level.s-barbara.tasks.s-carroll.hint.0",
        "@level.s-barbara.tasks.s-carroll.hint.1"
      ],
      "solution": [
        "g = allI(body: h) {",
        "  body {",
        "    h = impI[A=\"A(a)\"](body: k) {",
        "      body {",
        "        k = impI[A=\"C(a)\"](body: m4) {",
        "          body {",
        "            e1 = allE[t=a](p)",
        "            e3 = allE[t=a](r)",
        "            e2 = allE[t=a](q)",
        "            m1 = mp(e1, h.body)",
        "            m2 = mp(e2, k.body)",
        "            m3 = mp(e3, m1)",
        "            m4 = mp(m3, m2)",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ],
      "tray": "proof",
      "intro": [
        {
          "t": "@level.s-barbara.tasks.s-carroll.intro.0.t"
        }
      ],
      "step": "@level.s-barbara.tasks.s-carroll.step"
    }
  ]
}
