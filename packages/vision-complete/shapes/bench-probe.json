{
  "type": "obj",
  "fields": {
    "model": {
      "type": "oneOf",
      "values": [
        "vision-complete/probe"
      ]
    },
    "setup": {
      "type": "obj",
      "fields": {
        "N": {
          "type": "int",
          "min": 2
        },
        "wave": {
          "type": "obj",
          "fields": {
            "k": {
              "type": "int"
            },
            "A": {
              "type": "num"
            }
          },
          "about": "@shape.bench-probe.fields.setup.fields.wave.about"
        }
      }
    },
    "cases": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "label": {
            "type": "text"
          }
        }
      },
      "min": 2,
      "optional": true
    },
    "stages": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "title": {
            "type": "text"
          },
          "note": {
            "type": "text"
          },
          "opens": {
            "type": "shape",
            "name": "image/stage-opens"
          },
          "start": {
            "type": "map",
            "of": {
              "type": "any"
            },
            "optional": true
          },
          "goal": {
            "type": "shape",
            "name": "image/bench-goals"
          },
          "win": {
            "type": "text",
            "optional": true
          },
          "status": {
            "type": "text",
            "optional": true
          },
          "kind": {
            "type": "oneOf",
            "values": [
              "find",
              "read",
              "blind",
              "combine"
            ],
            "about": "@shape.bench-probe.fields.stages.of.fields.kind.about"
          },
          "input": {
            "type": "obj",
            "fields": {
              "c": {
                "type": "num"
              },
              "waves": {
                "type": "list",
                "of": {
                  "type": "obj",
                  "fields": {
                    "k": {
                      "type": "int"
                    },
                    "A": {
                      "type": "num"
                    },
                    "shift": {
                      "type": "num",
                      "optional": true
                    }
                  }
                }
              }
            },
            "optional": true
          },
          "checks": {
            "type": "list",
            "of": {
              "type": "num"
            },
            "about": "@shape.bench-probe.fields.stages.of.fields.checks.about",
            "optional": true
          },
          "answers": {
            "type": "str"
          }
        }
      },
      "min": 1,
      "optional": true
    },
    "knobs": {
      "type": "shape",
      "name": "image/bench-knobs"
    }
  }
}
