{
  "title": "@level.pl-anc.title",
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.pl-anc.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "pl-anc",
      "kind": "logic/machine",
      "want": "logic/answers",
      "backtrack": true,
      "rules": {
        "anc1": {
          "name": "@level.pl-anc.tasks.pl-anc.rules.anc1.name",
          "premises": [
            "Parent(?x, ?y)"
          ],
          "conclusion": "Anc(?x, ?y)"
        },
        "anc2": {
          "name": "@level.pl-anc.tasks.pl-anc.rules.anc2.name",
          "premises": [
            "Parent(?x, ?y)",
            "Anc(?y, ?z)"
          ],
          "conclusion": "Anc(?x, ?z)"
        }
      },
      "brief": "@level.pl-anc.tasks.pl-anc.brief",
      "hint": [
        "@level.pl-anc.tasks.pl-anc.hint.0"
      ],
      "tests": [
        {
          "goal": "Anc(i, ?w)",
          "hyps": [
            "Parent(i, j)",
            "Parent(j, k)",
            "Parent(j, l)",
            "Parent(l, m)",
            "Parent(n, m)"
          ],
          "answers": [
            "j",
            "k",
            "l",
            "m"
          ]
        },
        {
          "goal": "Anc(?w, m)",
          "hyps": [
            "Parent(i, j)",
            "Parent(j, k)",
            "Parent(j, l)",
            "Parent(l, m)",
            "Parent(n, m)"
          ],
          "answers": [
            "i",
            "j",
            "l",
            "n"
          ]
        }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    one = logic/directBackward-anc1(c0.body)",
        "    more = logic/directBackward-anc2(c0.body)",
        "    both = append(first: one, second: more)",
        "    c1 = logic/directBackward-logic_assumption(both)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "one = logic/directBackward-anc1(in)",
        "more = logic/directBackward-anc2(in)",
        "both = append(first: one, second: more)",
        "fact = logic/directBackward-logic_assumption(both)",
        "next = logic/directBackward-anc1(fact)",
        "close = logic/directBackward-logic_assumption(next)",
        "out <- close"
      ]
    }
  ]
}
