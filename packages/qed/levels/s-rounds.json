{
  "title": "@level.s-rounds.title",
  "after": "@level.s-rounds.after",
  "adds": ["repeat"],
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [{ "t": "@level.s-rounds.intro.0.t" }],
  "tasks": [
    {
      "id": "s-rounds",
      "kind": "logic/machine",
      "want": "logic/proved",
      "budget": 4,
      "brief": "@level.s-rounds.tasks.s-rounds.brief",
      "hint": ["@level.s-rounds.tasks.s-rounds.hint.0"],
      "tests": [
        { "goal": "Rain → (Wind → (Wet → Rain))" },
        { "goal": "Rain → Rain" },
        { "goal": "Rain → (Wind → (Wet → (Slip → (Fall → Wind))))" }
      ],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1 = logic/directBackward-qed_impI(c0.body)",
        "  }",
        "}",
        "close = logic/directBackward-logic_assumption(c0)",
        "out <- close"
      ],
      "naive": [
        "step1 = logic/directBackward-qed_impI(in)",
        "step2 = logic/directBackward-qed_impI(step1)",
        "step3 = logic/directBackward-qed_impI(step2)",
        "step4 = logic/directBackward-logic_assumption(step3)",
        "out <- step4"
      ]
    }
  ]
}
