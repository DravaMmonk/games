{
  "title": "@level.iffUse.title",
  "after": "@level.iffUse.after",
  "tray": "proof",
  "intro": [
    {
      "t": "@level.iffUse.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "decl-iff-2",
      "kind": "logic/iso",
      "step": "@level.decl-iff.tasks.decl-iff-2.step",
      "intro": [{ "t": "@level.decl-iff.tasks.decl-iff-2.intro.0.t" }],
      "brief": "@level.decl-iff.tasks.decl-iff-2.brief",
      "hint": [
        "@level.decl-iff.tasks.decl-iff-2.hint.0"
      ],
      "declare": "@level.decl-iff.tasks.decl-iff-2.declare",
      "target": "A ↔ B",
      "sentences": ["A → B", "B → A"],
      "tests": [
        {
          "given": ["A → B", "B → A"],
          "make": true
        },
        { "given": ["A → B"], "make": false },
        { "given": ["B → A"], "make": false },
        { "given": [], "make": false },
        { "given": ["A ↔ B"], "goal": "A → B", "make": true },
        { "given": ["A ↔ B", "B"], "goal": "A", "make": true },
        { "given": ["A ↔ B"], "goal": "A", "make": false }
      ],
      "solution": [
        { "binds": [], "needs": ["A → B", "B → A"] }
      ],
      "naive": [{ "binds": [], "needs": ["A → B"] }, { "binds": [], "needs": ["B → A"] }],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Hungry",
          "B": "Eat"
        }
      ]
    },
    {
      "id": "iffUse-1",
      "kind": "logic/proof",
      "step": "@level.iffUse.tasks.iffUse-1.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "A"
          },
          "goal": "B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "hint": [
        "@level.iffUse.tasks.iffUse-1.hint.0"
      ],
      "solution": [
        "e = andE(p)",
        "m = mp(e.left, q)",
        "goal <- m"
      ]
    },
    {
      "id": "iffUse-2",
      "kind": "logic/proof",
      "step": "@level.iffUse.tasks.iffUse-2.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "¬A"
          },
          "goal": "¬B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "hint": [
        "@level.iffUse.tasks.iffUse-2.hint.0"
      ],
      "solution": [
        "f = impI[A=B](body: m2) {",
        "  body {",
        "    m1 = mp(e.right, f.body)",
        "    m2 = mp(q, m1)",
        "  }",
        "}",
        "e = andE(p)",
        "goal <- f"
      ]
    },
    {
      "id": "iffUse-subst",
      "kind": "logic/proof",
      "adds": ["iffSubst"],
      "step": "@level.iffUse.tasks.iffUse-subst.step",
      "intro": [{ "t": "@level.iffUse.tasks.iffUse-subst.intro.0.t" }],
      "brief": "@level.iffUse.tasks.iffUse-subst.brief",
      "hint": ["@level.iffUse.tasks.iffUse-subst.hint.0"],
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "¬A"
          },
          "goal": "¬B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "solution": ["r = iffSubst[at=\"0\"](p, q)", "goal <- r"]
    }
  ],
  "opens": [
    "andE-iffUse-desc"
  ]
}
