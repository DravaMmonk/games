{
  "title": "@level.read-rules.title",
  "tray": "proof",
  "intro": [
    {
      "t": "@level.read-rules.intro.0"
    },
    {
      "t": "@level.read-rules.intro.1"
    },
    {
      "t": "@level.read-rules.intro.2"
    }
  ],
  "after": "@level.read-rules.after",
  "tasks": [
    {
      "id": "rule-apply",
      "kind": "logic/proof",
      "step": "@level.read-rules.rule-apply.step",
      "brief": "@level.read-rules.rule-apply.brief",
      "hint": [
        "@level.read-rules.rule-apply.hint"
      ],
      "tests": [
        {
          "premises": {
            "p": "A → B",
            "q": "A"
          },
          "goal": "B"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        }
      ],
      "solution": [
        "m = mp(p, q)",
        "goal <- m"
      ]
    },
    {
      "id": "rule-box",
      "kind": "logic/proof",
      "step": "@level.read-rules.rule-box.step",
      "brief": "@level.read-rules.rule-box.brief",
      "hint": [
        "@level.read-rules.rule-box.hint"
      ],
      "tests": [
        {
          "premises": {
            "p": "A → B",
            "q": "A → (B → C)"
          },
          "goal": "A → C"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind",
          "C": "Wet"
        }
      ],
      "solution": [
        "f = impI[A=A](body: m3) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(q, f.body)",
        "    m3 = mp(m2, m1)",
        "  }",
        "}",
        "goal <- f"
      ]
    },
    {
      "id": "rule-chain",
      "kind": "logic/proof",
      "step": "@level.read-rules.rule-chain.step",
      "brief": "@level.read-rules.rule-chain.brief",
      "hint": [
        "@level.read-rules.rule-chain.hint"
      ],
      "tests": [
        {
          "premises": {
            "p": "A → B",
            "q": "B → C",
            "r": "A"
          },
          "goal": "C"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet",
          "C": "Slip"
        }
      ],
      "solution": [
        "m = chain(p, q)",
        "result = mp(m, r)",
        "goal <- result"
      ]
    }
  ]
}
