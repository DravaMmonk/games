{
  "extends": "operation",
  "items": {
    "held": {
      "about": {
        "zh": "寄存器 register 此刻存的值；还没存过时给 start",
        "en": "what register `register` holds now; `start` until something is kept in it"
      },
      "args": [],
      "returns": "kernel/any",
      "params": {
        "type": "obj",
        "fields": {
          "reg": {
            "type": "str",
            "control": "tree",
            "default": "A"
          },
          "start": {
            "type": "any",
            "control": "number",
            "optional": true,
            "default": null
          }
        }
      }
    },
    "keep": {
      "about": {
        "zh": "把输入存入指定的寄存器，从下一拍起读到。",
        "en": "Save the input in the selected register so it can be read from the next tick."
      },
      "args": [
        {
          "name": "in",
          "type": "kernel/number"
        }
      ],
      "returns": "kernel/number",
      "params": {
        "type": "obj",
        "fields": {
          "reg": {
            "type": "str",
            "control": "tree",
            "default": "A"
          }
        }
      }
    }
  }
}
