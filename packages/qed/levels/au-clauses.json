{
  "title": "@level.au-clauses.title",
  "adds": [
    "toClauses",
    "skolem"
  ],
  "local": [
    "toClauses",
    "skolem"
  ],
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.au-clauses.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "au-clauses",
      "kind": "logic/machine",
      "want": "logic/clauses",
      "brief": "@level.au-clauses.tasks.au-clauses.brief",
      "hint": [
        "@level.au-clauses.tasks.au-clauses.hint.0",
        "@level.au-clauses.tasks.au-clauses.hint.1"
      ],
      "tests": [
        {
          "goal": "Wet",
          "hyps": [
            "Rain → Wet",
            "Rain"
          ],
          "clauses": [
            "¬Rain ∨ Wet",
            "Rain",
            "¬Wet"
          ]
        },
        {
          "goal": "OnTime",
          "hyps": [
            "Bus ∨ Bike",
            "Bus → OnTime",
            "Bike → OnTime"
          ],
          "clauses": [
            "Bus ∨ Bike",
            "¬Bus ∨ OnTime",
            "¬Bike ∨ OnTime",
            "¬OnTime"
          ]
        },
        {
          "goal": "Mortal(h)",
          "hyps": [
            "∀x. Human(x) → Mortal(x)",
            "Human(h)"
          ],
          "clauses": [
            "¬Human(x) ∨ Mortal(x)",
            "Human(h)",
            "¬Mortal(h)"
          ]
        },
        {
          "goal": "∀x. Baby(x) → ¬Tamer(x)",
          "hyps": [
            "∀x. Baby(x) → ¬Logical(x)"
          ],
          "clauses": [
            "¬Baby(x) ∨ ¬Logical(x)",
            "Baby(a)",
            "Tamer(a)"
          ]
        }
      ],
      "solution": [
        "a = logic/directBackward-qed_raa(in)",
        "b = logic/directBackward-qed_impI(a)",
        "c = cnf[at=hyps](b)",
        "d = skolem(c)",
        "e = toClauses(d)",
        "out <- e"
      ],
      "naive": [
        "c = cnf[at=hyps](in)",
        "d = skolem(c)",
        "e = toClauses(d)",
        "out <- e"
      ],
      "publishes": [
        {
          "part": "clausify",
          "variant": "base"
        }
      ]
    }
  ]
}
