      "step": "@level.kk-two.tasks.kk-two-1.step",
      "blind": true,
      "target": "KA ↔ ¬KA ∧ ¬KB",
      "brief": "@level.kk-two.tasks.kk-two-1.brief",
      "hint": [
        "@level.kk-two.tasks.kk-two-1.hint.0"
      ],
      "solution": [
        "na = gNot(KA)",
        "nb = gNot(KB)",
        "both = gAnd(na, nb)",
        "e = gIff(KA, both)",
        "out <- e"
      ]
    },
    {
      "id": "kk-two-2",
