{
  "title": "@level.q-allI.title",
  "intro": [
    {
      "t": "@level.q-allI.intro.0.t"
    },
    {
      "t": "@level.q-allI.intro.1.t"
    }
  ],
  "tasks": [
    {
      "id": "q-allI",
      "kind": "logic/proof",
      "tests": [
        {
          "goal": "∀x. P(x) → P(x)"
        }
      ],
      "cases": [
        {
          "P": "Human",
          "Q": "Mortal"
        },
        {
          "P": "Student",
          "Q": "School"
        }
      ],
      "hint": [
        "@level.q-allI.tasks.q-allI.hint.0",
        "@level.q-allI.tasks.q-allI.hint.1"
      ],
      "solution": [
        "g = allI(body: h) {",
        "  body {",
        "    h = impI[A=\"P(a)\"](body: h.body)",
        "  }",
        "}",
        "goal <- g"
      ],
      "tray": "proof",
      "adds": [
        "allI"
      ],
      "step": "@level.q-allI.tasks.q-allI.step",
      "after": "@level.q-allI.tasks.q-allI.after"
    },
    {
      "id": "q-allE",
      "kind": "logic/proof",
      "consts": [
        "i"
      ],
      "tests": [
        {
          "premises": {
            "p": "∀x. P(x) → Q(x)",
            "q": "P(i)"
          },
          "goal": "Q(i)"
        }
      ],
      "cases": [
        {
          "P": "Human",
          "Q": "Mortal"
        },
        {
          "P": "Student",
          "Q": "School"
        }
      ],
      "hint": [
        "@level.q-allI.tasks.q-allE.hint.0"
      ],
      "solution": [
        "e = allE[t=i](p)",
        "m = mp(e, q)",
        "goal <- m"
      ],
      "tray": "proof",
      "adds": [
        "allE"
      ],
      "intro": [
        {
          "t": "@level.q-allI.tasks.q-allE.intro.0.t"
        }
      ],
      "step": "@level.q-allI.tasks.q-allE.step"
    }
  ]
}
