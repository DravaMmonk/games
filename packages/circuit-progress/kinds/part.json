{
  "extends": "circuit/part",
  "fields": {
    "stages": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "id": {
            "type": "str",
            "pattern": "^(?:[a-z][a-z0-9-]*/)?[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "text",
            "optional": true
          },
          "desc": {
            "type": "shape",
            "name": "circuit/optional-part-description",
            "optional": true
          },
          "settings": {
            "type": "shape",
            "name": "circuit/inline-settings"
          },
          "rules": {
            "type": "shape",
            "name": "circuit/rules"
          },
          "checks": {
            "type": "shape",
            "name": "circuit/checks"
          },
          "icon": {
            "type": "shape",
            "name": "circuit/icon-name"
          },
          "family": {
            "type": "ref",
            "kind": "family",
            "optional": true
          },
          "views": {
            "type": "shape",
            "name": "circuit/part-views"
          },
          "inputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "optional": true
          },
          "outputs": {
            "type": "list",
            "of": {
              "type": "shape",
              "name": "circuit/ports"
            },
            "min": 2,
            "optional": true
          }
        }
      },
      "optional": true
    }
  },
  "declares": "package",
  "overrides": {
    "package": [
      "*"
    ],
    "game": [
      "$text"
    ]
  }
}
