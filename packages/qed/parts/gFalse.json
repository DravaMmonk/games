{
  "name": "@part.gFalse.name",
  "desc": "@part.gFalse.desc",
  "family": "logic/gate",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic/gates",
        "target": "(Rain → Wet) ∧ (Rain ∧ ¬Wet)",
        "solution": [
          "i = gImp(Rain, Wet)",
          "n = gNot(Wet)",
          "a1 = gAnd(Rain, n)",
          "a2 = gAnd(i, a1)",
          "out <- a2"
        ]
      }
    }
  ],
  "inputs": [{ "name": "a", "type": "kernel/boolean" }, { "name": "b", "type": "kernel/boolean" }],
  "outputType": "kernel/boolean"
}
