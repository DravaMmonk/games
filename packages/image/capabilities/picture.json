        "zh": "一个 4 × 4 的图案（一个图块），亮度 hi",
        "en": "a 4 × 4 pattern (one patch) at brightness hi"
      },
      "params": {
        "type": "obj",
        "fields": {
          "name": {
            "type": "oneOf",
            "values": [
              "X",
              "C",
              "P",
              "K",
              "R",
              "S"
            ]
