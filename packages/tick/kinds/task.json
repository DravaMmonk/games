{
  "extends": "task",
  "fields": {
    "stage": {
      "type": "text",
      "section": "read",
      "about": "@kind.task.fields.stage.about",
      "optional": true
    },
    "hint": {
      "type": "list",
      "of": {
        "type": "text"
      },
      "optional": true
    },
    "intro": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "t": {
            "type": "text"
          },
          "show": {
            "type": "by",
            "field": "shape",
            "cases": {
              "scalar": {
                "type": "obj",
                "fields": {
                  "shape": {
                    "type": "oneOf",
                    "values": [
                      "scalar"
                    ]
                  },
                  "value": {
                    "type": "any"
                  },
                  "label": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              "grid": {
                "type": "obj",
                "fields": {
                  "shape": {
                    "type": "oneOf",
                    "values": [
                      "grid"
                    ]
                  },
                  "value": {
                    "type": "list",
                    "of": {
                      "type": "list",
                      "of": {
                        "type": "either",
                        "of": [
                          {
                            "type": "num"
                          },
                          {
                            "type": "list",
                            "of": {
                              "type": "num"
                            },
                            "min": 3
                          }
                        ]
                      },
                      "min": 1
                    },
                    "min": 1,
                    "view": "grid"
                  },
                  "views": {
                    "type": "shape",
                    "name": "tick/views"
                  },
                  "label": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              "bits": {
                "type": "obj",
                "fields": {
                  "shape": {
                    "type": "oneOf",
                    "values": [
                      "bits"
                    ]
                  },
                  "value": {
                    "type": "either",
                    "of": [
                      {
                        "type": "str"
                      },
                      {
                        "type": "list",
                        "of": {
                          "type": "any"
                        }
                      }
                    ]
                  },
                  "views": {
                    "type": "shape",
                    "name": "tick/views"
                  },
                  "label": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              "ticks": {
                "type": "obj",
                "fields": {
                  "shape": {
                    "type": "oneOf",
                    "values": [
                      "ticks"
                    ]
                  },
                  "value": {
                    "type": "list",
                    "of": {
                      "type": "any"
                    }
                  },
                  "views": {
                    "type": "shape",
                    "name": "tick/views"
                  },
                  "label": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              "list": {
                "type": "obj",
                "fields": {
                  "shape": {
                    "type": "oneOf",
                    "values": [
                      "list"
                    ]
                  },
                  "value": {
                    "type": "list",
                    "of": {
                      "type": "any"
                    }
                  },
                  "label": {
                    "type": "text",
                    "optional": true
                  }
                }
              }
            },
            "about": "@kind.task.fields.intro.of.fields.show.about",
            "optional": true
          }
        }
      },
      "section": "read",
      "about": "@kind.task.fields.intro.about",
      "optional": true
    },
    "listens": {
      "type": "bool",
      "optional": true
    },
    "talks": {
      "type": "bool",
      "about": "@kind.task.fields.talks.about",
      "optional": true
    },
    "inputs": {
      "type": "shape",
      "name": "tick/inputs"
    },
    "outputs": {
      "type": "shape",
      "name": "tick/inputs"
    },
    "tests": {
      "type": "list",
      "of": {
        "type": "shape",
        "name": "tick/test"
      },
      "min": 1,
      "section": "tests"
    },
    "hidden": {
      "type": "list",
      "of": {
        "type": "shape",
        "name": "tick/test"
      },
      "section": "tests",
      "about": "@kind.task.fields.hidden.about",
      "optional": true
    },
    "want": {
      "type": "map",
      "of": {
        "type": "call",
        "kind": "tick/want"
      },
      "about": "@kind.task.fields.want.about"
    },
    "solution": {
      "type": "board"
    },
    "naive": {
      "type": "list",
      "of": {
        "type": "str"
      },
      "view": "board",
      "about": "@kind.task.fields.naive.about",
      "optional": true
    },
    "starter": {
      "type": "list",
      "of": {
        "type": "str"
      },
      "view": "board",
      "about": "@kind.task.fields.starter.about",
      "optional": true
    },
    "results": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "of": {
            "type": "str",
            "about": "@kind.task.fields.results.of.fields.of.about"
          },
          "views": {
            "type": "shape",
            "name": "tick/views"
          },
          "label": {
            "type": "text",
            "optional": true
          }
        }
      },
      "min": 1,
      "section": "read",
      "about": "@kind.task.fields.results.about",
      "optional": true
    },
    "views": {
      "type": "obj",
      "fields": {
        "scalar": {
          "type": "shape",
          "name": "tick/views"
        },
        "grid": {
          "type": "shape",
          "name": "tick/views"
        },
        "bits": {
          "type": "shape",
          "name": "tick/views"
        },
        "ticks": {
          "type": "shape",
          "name": "tick/views"
        },
        "list": {
          "type": "shape",
          "name": "tick/views"
        }
      },
      "about": "@kind.task.fields.views.about",
      "section": "read",
      "optional": true
    }
  },
  "declares": "package",
  "overrides": {
    "package": [
      "*"
    ],
    "game": [
      "$text"
    ]
  },
  "play": "tick/board"
}
