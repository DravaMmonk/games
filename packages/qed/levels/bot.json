  "after": "@level.bot.after",
  "tasks": [
    {
      "id": "bot-1",
      "kind": "logic/proof",
      "step": "@level.bot.tasks.bot-1.step",
      "tests": [
        {
          "premises": {
            "p": "A",
            "q": "¬A"
          },
          "goal": "B"
        }
      ],
      "cases": [
        {
          "A": "Locked",
          "B": "Moon"
        },
        {
          "A": "Rain",
          "B": "Pigs"
        }
      ],
      "hint": [
        "@level.bot.tasks.bot-1.hint.0",
        "@level.bot.tasks.bot-1.hint.1"
      ],
      "solution": [
        "m = mp(q, p)",
        "b = botE[C=B](m)",
        "goal <- b"
      ]
    },
    {
      "id": "bot-2",
      "kind": "logic/proof",
      "step": "@level.bot.tasks.bot-2.step",
      "tests": [
        {
          "premises": {
            "p": "¬A"
          },
          "goal": "A → B"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Locked",
          "B": "Moon"
        }
      ],
      "hint": [
        "@level.bot.tasks.bot-2.hint.0"
      ],
      "intro": [
        {
          "t": "@level.bot.tasks.bot-2.intro.0.t"
        }
      ],
      "solution": [
        "f = impI[A=A](body: b) {",
        "  body {",
        "    m = mp(p, f.body)",
        "    b = botE[C=B](m)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ],
  "opens": [
