      ],
      "brief": "@level.s-mix.tasks.s-mix.brief",
      "hint": [
        "@level.s-mix.tasks.s-mix.hint.0",
        "@level.s-mix.tasks.s-mix.hint.1"
      ],
      "solution": [
        "hypRule = logic/assumption()",
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c2 = rule(c0.body, hypRule)",
        "    c3r0 = impI()",
        "    c3 = rule(c0.body, c3r0)",
        "    c4r0 = mp[use=[mp]]()",
        "    c4 = rule(c0.body, c4r0)",
        "    c1 = append[ways=\"3\"](first: c2, second: c3, third: c4)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
