        "subt(vx, y) = y",
        "subt(dg(x), y) = dg(subt(x, y))",
        "subt(qt(x), y) = qt(x)",
        "val(qt(x)) = x",
        "val(dg(x)) = diag(val(x))"
      ],
      "tests": [
        { "goal": "diag(nprov(dg(vx))) = nprov(dg(qt(nprov(dg(vx)))))" },
        { "goal": "val(dg(qt(nprov(dg(vx))))) = nprov(dg(qt(nprov(dg(vx)))))" }
      ],
      "brief": "@level.gd-diag.tasks.gd-diag.brief",
      "hint": ["@level.gd-diag.tasks.gd-diag.hint.0"],
      "solution": [
        "c0 = proof-kit/repeat(in, body: c0_body) {",
        "  body {",
        "    c0_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c0.body)",
        "    c0_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c0.body)",
        "    c0_body_r3 = logic/directRewrite-math[use=[\"def.2\"]](c0.body)",
        "    c0_body_r4 = logic/directRewrite-math[use=[\"def.3\"]](c0.body)",
        "    c0_body_r5 = logic/directRewrite-math[use=[\"def.4\"]](c0.body)",
        "    c0_body_r6 = logic/directRewrite-math[use=[\"def.5\"]](c0.body)",
        "    c0_body_r7 = logic/directRewrite-math[use=[\"def.6\"]](c0.body)",
        "    c0_body_g1 = proof-kit/append[ways=\"6\"](first: c0_body_r1, second: c0_body_r2, third: c0_body_r3, fourth: c0_body_r4, fifth: c0_body_r5, sixth: c0_body_r6)",
        "    c0_body = proof-kit/append[ways=\"2\"](first: c0_body_g1, second: c0_body_r7)",
        "  }",
        "}",
        "c1 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c0)",
        "out <- c1"
      ]
    }
  ]
