        "type": "obj",
        "fields": {
          "k": {
            "type": "num",
            "optional": true
          },
          "cx": {
            "type": "num",
            "optional": true
          },
          "cy": {
            "type": "num",
            "optional": true
          },
          "A": {
            "type": "num",
            "optional": true
          },
          "size": {
            "type": "int",
            "min": 1,
            "about": {
              "zh": "边长（格）",
              "en": "the side, in cells"
            },
            "optional": true
          }
        }
      }
    },
    "fabric": {
      "about": {
