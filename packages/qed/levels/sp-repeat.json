{
  "title": "@level.sp-repeat.title",
  "after": "@level.sp-repeat.after",
  "adds": ["repeat"],
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.sp-repeat.intro.0.t"
    },
    { "t": "@level.sp-repeat.intro.1.t" }
  ],
  "tasks": [
    {
      "id": "sp-repeat",
      "kind": "logic/machine",
      "want": "logic/proved",
      "budget": 3,
      "brief": "@level.sp-repeat.tasks.sp-repeat.brief",
      "hint": [
        "@level.sp-repeat.tasks.sp-repeat.hint.0"
      ],
      "tests": [
        {
          "goal": "Rain",
          "hyps": ["Rain ↔ Wet", "Wet"]
        },
        {
          "goal": "Rain ∧ (Wind → Rain)",
          "hyps": ["Rain ↔ Wet", "Wet ∧ (Wind → Wet)"]
        },
        {
          "goal": "(Rain ∨ Slip) ∧ (Rain → (Wind ∧ Rain))",
          "hyps": ["Rain ↔ Wet", "(Wet ∨ Slip) ∧ (Wet → (Wind ∧ Wet))"]
        },
        { "goal": "Wind", "hyps": ["Wind"] }
      ],
      "solution": [
        "c0 = repeat(in, body: s1) {",
        "  body {",
        "    s1 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](c0.body)",
        "  }",
        "}",
        "cite = logic/directBackward-logic_assumption(c0)",
        "out <- cite"
      ],
      "naive": [
        "t1 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](in)",
        "t2 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](t1)",
        "t3 = logic/directBackward-logic_assumption(t2)",
        "out <- t3"
      ]
    }
  ]
}
