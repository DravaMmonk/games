{
  "title": "@level.in-succ.title",
  "tray": "prover",
  "tasks": [
    {
      "id": "in-succ",
      "kind": "logic/machine",
      "want": "logic/proved",
      "inputs": [{ "name": "in", "label": "@level.in-succ.tasks.in-succ.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["nat"],
      "defs": ["plus"],
      "tests": [{ "goal": "∀x. ∀y. plus(x, s(y)) = s(plus(x, y))" }],
      "brief": "@level.in-succ.tasks.in-succ.brief",
      "hint": ["@level.in-succ.tasks.in-succ.hint.0", "@level.in-succ.tasks.in-succ.hint.1"],
      "solution": [
        "c0 = logic/directBackward-math[use=[\"nat.induct\"]](in)",
        "c1 = proof-kit/each(c0, body: c4) {",
        "  body {",
        "    c2 = proof-kit/repeat(c1.body, body: c2_body) {",
        "      body {",
        "        c2_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c2.body)",
        "        c2_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c2.body)",
        "        c2_body_r3 = logic/directRewrite-logic_hyp[use=[\"hyp\"]](c2.body)",
        "        c2_body = proof-kit/append[ways=\"3\"](first: c2_body_r1, second: c2_body_r2, third: c2_body_r3)",
        "      }",
        "    }",
        "    c3 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c2)",
        "    c4 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c3)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](in)",
        "c1 = logic/directBackward-proof-kit_allI[use=[\"allI\"]](c0)",
        "c2 = proof-kit/repeat(c1, body: c2_body) {",
        "  body {",
        "    c2_body_r1 = logic/directRewrite-math[use=[\"def.0\"]](c2.body)",
        "    c2_body_r2 = logic/directRewrite-math[use=[\"def.1\"]](c2.body)",
        "    c2_body_r3 = logic/directRewrite-logic_hyp[use=[\"hyp\"]](c2.body)",
        "    c2_body = proof-kit/append[ways=\"3\"](first: c2_body_r1, second: c2_body_r2, third: c2_body_r3)",
        "  }",
        "}",
        "c3 = logic/directBackward-proof-kit_refl[use=[\"refl\"]](c2)",
        "out <- c3"
      ],
      "publishes": [{ "part": "qed-math/addSucc", "variant": "base" }]
    }
  ]
}
