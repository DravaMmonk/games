{
  "title": "@level.s-loop.title",
  "after": "@level.s-loop.after",
  "withholds": ["mp.use=impE", "mp.use=cut", "andE.use=conjE", "allE.use=spec"],
  "tray": "prover",
  "intro": [
    {
      "t": "@level.s-loop.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "s-loop",
      "kind": "logic/machine",
      "want": "logic/proved",
      "backtrack": true,
      "rules": {
        "trans": {
          "name": "@level.s-loop.tasks.s-loop.rules.trans.name",
          "premises": [
            "Older(?x, ?y)",
            "Older(?y, ?z)"
          ],
          "conclusion": "Older(?x, ?z)"
        }
      },
      "brief": "@level.s-loop.tasks.s-loop.brief",
      "hint": [
        "@level.s-loop.tasks.s-loop.hint.0",
        "@level.s-loop.tasks.s-loop.hint.1"
      ],
      "tests": [
        {
          "goal": "Older(i, k)",
          "hyps": [
            "Older(i, j)",
            "Older(j, k)"
          ]
        },
        {
          "goal": "Older(j, l)",
          "hyps": [
            "Older(j, k)",
            "Older(k, l)"
          ]
        },
        {
          "goal": "Older(k, i)",
          "hyps": [
            "Older(i, j)",
            "Older(j, k)"
          ],
          "want": "logic/fails"
        }
      ],
      "solution": [
        "c0 = search[depth=\"3\"](in, body: c1) {",
        "  body {",
        "    cite = logic/directBackward-logic_assumption(c0.body)",
        "    pass = logic/directBackward-trans(c0.body)",
        "    c1 = append(first: cite, second: pass)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    cite = logic/directBackward-logic_assumption(c0.body)",
        "    pass = logic/directBackward-trans(c0.body)",
        "    c1 = append(first: cite, second: pass)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
