      "step": "@level.iffUse.tasks.iffUse-1.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "A"
          },
          "goal": "B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
