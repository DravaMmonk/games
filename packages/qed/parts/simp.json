{
  "name": "@part.simp.name",
  "desc": "@part.simp.desc",
  "family": "logic/built",
  "settings": {
    "at": {
      "control": "select",
      "label": "@part.simp.settings.at.label",
      "options": [
        {
          "value": "goal",
          "label": "@part.simp.settings.at.options.0.label"
        },
        {
          "value": "hyps",
          "label": "@part.simp.settings.at.options.1.label"
        }
      ],
      "default": "goal"
    }
  },
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic/machine",
        "solution": [
          "c0 = repeat(in, body: s2) {",
          "  body {",
          "    s1 = logic/directRewrite-qed_rewrite[use=[\"hyp.eq\"],at=goal-0](c0.body)",
          "    s2 = logic/directRewrite-qed_iffSubst[use=[\"hyp.iff\"],at=goal-0](s1)",
          "  }",
          "}",
          "out <- c0"
        ],
        "want": "logic/becomes",
        "directRuleCards": true,
        "inputs": [
          {
            "name": "in",
            "label": "in"
          }
        ],
        "tests": [
          {
            "goal": "Bright(i) ∧ Wind"
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "name": "in",
      "type": "logic/machine-value"
    }
  ],
  "outputType": "logic/machine-value"
}
