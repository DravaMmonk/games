{
  "title": "@level.h-and-make.title",
  "intro": [
    {
      "t": "@level.h-and-make.intro.0.t"
    },
    {
      "t": "@level.h-and-make.intro.1.t"
    }
  ],
  "tasks": [
    {
      "id": "h-and-make-1",
      "kind": "logic/proof",
      "step": "@level.h-and-make.tasks.h-and-make-1.step",
      "tests": [
        {
          "premises": {
            "p": "A",
            "q": "B"
          },
          "goal": "∀R. (A → (B → R)) → R"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind"
        },
        {
          "A": "Sat",
          "B": "Sun"
        }
      ],
      "hint": [
        "@level.h-and-make.tasks.h-and-make-1.hint.0",
        "@level.h-and-make.tasks.h-and-make-1.hint.1"
      ],
      "solution": [
        "s = allI[x=R](body: f) {",
        "  body {",
        "    f = impI[A=\"A -> B -> R\"](body: m2) {",
        "      body {",
        "        m1 = mp(f.body, p)",
        "        m2 = mp(m1, q)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- s"
      ],
      "tray": "proof"
    },
    {
      "id": "h-and-make-2",
      "kind": "logic/proof",
      "step": "@level.h-and-make.tasks.h-and-make-2.step",
      "tests": [
        {
          "premises": {
            "p": "∀R. (A → (B → R)) → R"
          },
          "goal": "A"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind"
        },
        {
          "A": "Sat",
          "B": "Sun"
        }
      ],
      "intro": [
        {
          "t": "@level.h-and-make.tasks.h-and-make-2.intro.0.t"
        }
      ],
      "hint": [
        "@level.h-and-make.tasks.h-and-make-2.hint.0",
        "@level.h-and-make.tasks.h-and-make-2.hint.1"
      ],
      "solution": [
        "k = axK[A=A, B=B]()",
        "e = allE[t=A](p)",
        "m = mp(e, k)",
        "goal <- m"
      ],
      "tray": "proof",
      "after": "@level.h-and-make.tasks.h-and-make-2.after"
    },
    {
      "id": "h-eq-subst",
      "kind": "logic/proof",
      "consts": [
        "i",
        "j"
      ],
      "propertyWords": true,
      "words": [
        "qed/everyday",
        "qed/stars",
        "qed/properties"
      ],
      "tests": [
        {
          "premises": {
            "e": "∀P. P(i) → P(j)",
            "p": "B(i)"
          },
          "goal": "B(j)"
        }
      ],
      "cases": [
        {
          "B": "Bright"
        },
        {
          "B": "Seen"
        }
      ],
      "hint": [
        "@level.h-and-make.tasks.h-eq-subst.hint.0",
        "@level.h-and-make.tasks.h-eq-subst.hint.1"
      ],
      "solution": [
        "i = allE[t=\"B(x)\"](e)",
        "m = mp(i, p)",
        "goal <- m"
      ],
      "tray": "proof",
      "intro": [
        {
          "t": "@level.h-and-make.tasks.h-eq-subst.intro.0.t"
        },
        {
          "t": "@level.h-and-make.tasks.h-eq-subst.intro.1.t"
        }
      ],
      "step": "@level.h-and-make.tasks.h-eq-subst.step",
      "after": "@level.h-and-make.tasks.h-eq-subst.after"
    },
    {
      "id": "h-eq-sym",
      "kind": "logic/proof",
      "consts": [
        "i",
        "j"
      ],
      "propertyWords": true,
      "words": [
        "qed/everyday",
        "qed/stars",
        "qed/properties"
      ],
      "tests": [
        {
          "premises": {
            "e": "∀P. P(i) → P(j)"
          },
          "goal": "∀Q. Q(j) → Q(i)"
        }
      ],
      "cases": [],
      "brief": "@level.h-and-make.tasks.h-eq-sym.brief",
      "hint": [
        "@level.h-and-make.tasks.h-eq-sym.hint.0",
        "@level.h-and-make.tasks.h-eq-sym.hint.1"
      ],
      "solution": [
        "s = allI[x=Q](body: m) {",
        "  body {",
        "    f = impI[A=\"Q(i)\"](body: f.body)",
        "    i = allE[t=\"Q(x) -> Q(i)\"](e)",
        "    m = mp(i, f)",
        "  }",
        "}",
        "goal <- s"
      ],
      "tray": "proof",
      "intro": [
        {
          "t": "@level.h-and-make.tasks.h-eq-sym.intro.0.t"
        }
      ],
      "step": "@level.h-and-make.tasks.h-eq-sym.step",
      "after": "@level.h-and-make.tasks.h-eq-sym.after"
    }
  ]
}
