{
  "extends": "task",
  "play": "image/board",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "shape",
      "name": "image/task-unlocks"
    },
    "carries": {
      "type": "shape",
      "name": "image/carry-board"
    },
    "bench": {
      "type": "by",
      "field": "model",
      "fields": {
        "actions": {
          "type": "list",
          "of": {
            "type": "either",
            "of": [
              {
                "type": "obj",
                "fields": {
                  "id": {
                    "type": "shape",
                    "name": "image/action-id"
                  },
                  "act": { "type": "str" },
                  "arg": { "type": "any", "optional": true },
                  "label": { "type": "text" },
                  "primary": { "type": "bool", "optional": true },
                  "icon": { "type": "oneOf", "values": ["reset"], "optional": true },
                  "repeat": { "type": "int", "min": 2, "optional": true },
                  "every": { "type": "int", "min": 1, "optional": true },
                  "always": {
                    "type": "bool",
                    "about": "@kind.bench-task.fields.bench.fields.actions.of.of.0.fields.always.about",
                    "optional": true
                  }
                }
              },
              {
                "type": "obj",
                "fields": {
                  "id": {
                    "type": "shape",
                    "name": "image/action-id"
                  },
                  "reset": { "type": "list", "of": { "type": "str" } },
                  "label": { "type": "text" },
                  "icon": { "type": "oneOf", "values": ["reset"], "optional": true }
                }
              }
            ]
          },
          "optional": true
        },
        "goal": {
          "type": "shape",
          "name": "image/bench-goals"
        },
        "check": {
          "type": "oneOf",
          "values": ["live", "submit"],
          "about": "@kind.bench-task.fields.bench.fields.check.about",
          "optional": true
        },
        "win": { "type": "text", "optional": true },
        "status": { "type": "text", "optional": true },
        "layout": {
          "type": "obj",
          "fields": {
            "head": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "main": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              }
            },
            "side": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "foot": {
              "type": "list",
              "of": {
                "type": "shape",
                "name": "image/bench-layout-region"
              },
              "optional": true
            },
            "split": {
              "type": "oneOf",
              "values": ["even", "narrow", "wide"],
              "about": "@kind.bench-task.fields.bench.fields.layout.fields.split.about",
              "optional": true
            }
          }
        }
      },
      "casesFrom": "benchModel"
    }
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] },
  "caseGroups": "benchModel"
}
