{
  "name": "@part.auto.name",
  "desc": "@part.auto.desc",
  "family": "logic/built",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic/machine",
        "solution": [
          "c0 = search(in, body: c1) {",
          "  body {",
          "    cite = logic/directBackward-logic_assumption(c0.body)",
          "    open = logic/directBackward-qed_impI(c0.body)",
          "    any = logic/directBackward-qed_allI(open)",
          "    join = logic/directBackward-qed_andI(any)",
          "    left = logic/directBackward-qed_orI[use=[\"disjI1\"]](c0.body)",
          "    right = logic/directBackward-qed_orI[use=[\"disjI2\"]](c0.body)",
          "    example = logic/directBackward-qed_exI(c0.body)",
          "    e1 = logic/directBackward-qed_andE[use=[\"conjE\"]](c0.body)",
          "    e2 = logic/directBackward-qed_orE(c0.body)",
          "    e3 = logic/directBackward-qed_mp[use=[\"mp\"]](c0.body)",
          "    e4 = logic/directBackward-qed_exE(c0.body)",
          "    e5 = logic/directBackward-qed_allE[use=[\"allE\"]](c0.body)",
          "    given = append[ways=\"5\"](first: e1, second: e2, third: e3, fourth: e4, fifth: e5)",
          "    use = logic/directBackward-logic_assumption(given)",
          "    c1 = append[ways=\"6\"](first: cite, second: join, third: left, fourth: right, fifth: example, sixth: use)",
          "  }",
          "}",
          "out <- c0"
        ],
        "want": "logic/proved",
        "directRuleCards": true,
        "backtrack": true,
        "inputs": [{ "name": "in", "label": "in" }],
        "tests": [{ "goal": "Rain ∧ (Wind ∨ Wet) → (Rain ∧ Wind) ∨ (Rain ∧ Wet)" }]
