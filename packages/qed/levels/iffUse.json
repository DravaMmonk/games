{
  "title": "@level.iffUse.title",
  "intro": [
    {
      "t": "@level.iffUse.intro.0.t"
    }
  ],
  "opens": [
    "andE-iffUse-desc"
  ],
  "tasks": [
    {
      "id": "iffUse-1",
      "kind": "logic/proof",
      "step": "@level.iffUse.tasks.iffUse-1.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "A"
          },
          "goal": "B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "hint": [
        "@level.iffUse.tasks.iffUse-1.hint.0"
      ],
      "solution": [
        "e = andE(p)",
        "m = mp(e.left, q)",
        "goal <- m"
      ],
      "tray": "proof"
    },
    {
      "id": "iffUse-2",
      "kind": "logic/proof",
      "step": "@level.iffUse.tasks.iffUse-2.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "¬A"
          },
          "goal": "¬B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "hint": [
        "@level.iffUse.tasks.iffUse-2.hint.0"
      ],
      "solution": [
        "f = impI[A=B](body: m2) {",
        "  body {",
        "    m1 = mp(e.right, f.body)",
        "    m2 = mp(q, m1)",
        "  }",
        "}",
        "e = andE(p)",
        "goal <- f"
      ],
      "tray": "proof"
    },
    {
      "id": "iffUse-subst",
      "kind": "logic/proof",
      "adds": [
        "iffSubst"
      ],
      "step": "@level.iffUse.tasks.iffUse-subst.step",
      "intro": [
        {
          "t": "@level.iffUse.tasks.iffUse-subst.intro.0.t"
        }
      ],
      "brief": "@level.iffUse.tasks.iffUse-subst.brief",
      "hint": [
        "@level.iffUse.tasks.iffUse-subst.hint.0"
      ],
      "tests": [
        {
          "premises": {
            "p": "A ↔ B",
            "q": "¬A"
          },
          "goal": "¬B"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rest"
        },
        {
          "A": "Coffee",
          "B": "Awake"
        }
      ],
      "solution": [
        "r = iffSubst[at=\"0\"](p, q)",
        "goal <- r"
      ],
      "tray": "proof",
      "after": "@level.iffUse.tasks.iffUse-subst.after"
    }
  ]
}
