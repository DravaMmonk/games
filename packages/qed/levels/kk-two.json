      "tray": "proof",
      "step": "@level.kk-two.tasks.kk-two-2.step",
      "tests": [
        {
          "premises": {
            "p": "A ↔ ¬A ∧ ¬B"
          },
          "goal": "¬A ∧ B"
        }
      ],
      "cases": [
        {
          "A": "KA",
          "B": "KB"
        },
        {
          "A": "KC",
          "B": "KD"
        }
      ],
      "hint": [
        "@level.kk-two.tasks.kk-two-2.hint.0",
        "@level.kk-two.tasks.kk-two-2.hint.1"
      ],
      "solution": [
        "na = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(e.left, na.body)",
        "    s = andE(m1)",
        "    m2 = mp(s.left, na.body)",
        "  }",
        "}",
        "nnb = impI[A=\"~B\"](body: m3) {",
        "  body {",
        "    c = andI(na, nnb.body)",
        "    m3 = mp(t, c)",
        "  }",
        "}",
        "e = andE(p)",
        "b = raa(nnb)",
        "t = chain(e.right, na)",
        "both = andI(na, b)",
        "goal <- both"
      ]
    }
  ]
