{
  "extends": "task",
  "play": "image/probe",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "shape",
      "name": "image/task-unlocks"
    },
    "carries": {
      "type": "shape",
      "name": "image/carry-board"
    },
    "part": {
      "type": "ref",
      "kind": "part",
      "reference": "circuit/part"
    },
    "question": { "type": "text" },
    "answers": { "type": "list", "of": { "type": "str" } },
    "answer": { "type": "str" },
    "wrong": { "type": "text" },
    "probes": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": { "label": { "type": "text" }, "picture": { "type": "call", "kind": "picture" } }
      }
    }
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] }
}
