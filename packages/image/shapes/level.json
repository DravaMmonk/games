{
  "type": "obj",
  "fields": {
    "title": {
      "type": "text"
    },
    "after": {
      "type": "text",
      "about": "@shape.level.fields.after.about"
    },
    "intro": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "t": {
            "type": "text"
          },
          "fig": {
            "type": "either",
            "of": [
              {
                "type": "obj",
                "fields": {
                  "test": {
                    "type": "int",
                    "min": 0
                  },
                  "task": {
                    "type": "int",
                    "min": 0,
                    "optional": true
                  },
                  "view": {
                    "type": "ref",
                    "kind": "view",
                    "optional": true
                  },
                  "caption": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              {
                "type": "obj",
                "fields": {
                  "part": {
                    "type": "ref",
                    "kind": "primitive",
                    "reference": "circuit/part"
                  },
                  "params": {
                    "type": "map",
                    "of": {
                      "type": "any"
                    },
                    "optional": true
                  },
                  "input": {
                    "type": "either",
                    "of": [
                      {
                        "type": "oneOf",
                        "values": [
                          "test"
                        ]
                      },
                      {
                        "type": "call",
                        "kind": "picture"
                      }
                    ],
                    "optional": true
                  },
                  "inputs": {
                    "type": "list",
                    "of": {
                      "type": "either",
                      "of": [
                        {
                          "type": "oneOf",
                          "values": [
                            "test"
                          ]
                        },
                        {
                          "type": "call",
                          "kind": "picture"
                        }
                      ]
                    },
                    "optional": true
                  },
                  "view": {
                    "type": "ref",
                    "kind": "view",
                    "optional": true
                  },
                  "caption": {
                    "type": "text",
                    "optional": true
                  }
                }
              },
              {
                "type": "obj",
                "fields": {
                  "figure": {
                    "type": "str",
                    "pattern": "^[a-z0-9-]+$",
                    "about": "@shape.level.fields.intro.of.fields.fig.of.2.fields.figure.about"
                  },
                  "caption": {
                    "type": "text",
                    "optional": true
                  }
                }
              }
            ],
            "optional": true
          }
        }
      },
      "section": "read",
      "about": "@shape.level.fields.intro.about"
    },
    "tasks": {
      "type": "list",
      "min": 1,
      "of": {
        "type": "obj",
        "fields": {
          "id": {
            "type": "task"
          },
          "step": {
            "type": "text",
            "optional": true
          },
          "brief": {
            "type": "text"
          },
          "play": {
            "type": "str",
            "reference": "play"
          },
          "after": {
            "type": "text",
            "optional": true
          }
        }
      }
    },
    "carry": {
      "type": "level",
      "section": "course",
      "about": "@shape.level.fields.carry.about",
      "optional": true
    },
    "unlocks": {
      "type": "list",
      "of": {
        "type": "ref",
        "kind": "unlock"
      },
      "section": "course",
      "optional": true
    }
  }
}
