        "control": {
          "type": "oneOf",
          "values": [
            "select"
          ]
        },
        "label": {
          "type": "text",
          "optional": true
        },
        "about": {
          "type": "text",
          "about": {
            "zh": "悬停和详情里的一行说明",
            "en": "one line shown on hover and in the detail"
          },
          "optional": true
        },
        "default": {
          "type": "any",
          "about": {
            "zh": "新元件的值",
            "en": "the value a new part starts with"
          },
          "optional": true
        },
        "when": {
          "type": "str",
          "view": "expr",
          "about": {
            "zh": "式子：为真时才出现（只读设置）",
            "en": "an expression: shown only while it is true (reads settings only)"
          },
          "optional": true
        },
        "fixed": {
          "type": "bool",
          "about": {
            "zh": "只显示，玩家不能改",
            "en": "shown, not changed by the player"
          },
          "optional": true
        },
        "options": {
          "type": "list",
          "of": {
            "type": "obj",
            "fields": {
              "value": {
                "type": "str",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
                "about": {
                  "zh": "ASCII 值：写进蓝图文本",
                  "en": "an ASCII value, as blueprint text writes it"
                }
              },
              "label": {
                "type": "text",
                "optional": true
              },
              "icon": {
                "type": "str",
                "view": "icon",
                "about": {
                  "zh": "内核图标表里的一个名字",
                  "en": "a name in the kernel’s icon table"
                },
                "optional": true
              },
              "about": {
                "type": "text",
                "about": {
                  "zh": "这个选项做什么，一句完整的话：选项开放后接在元件说明后面",
                  "en": "what the option does, one whole sentence: added to the part’s description once the option opens"
                },
                "optional": true
              }
            }
