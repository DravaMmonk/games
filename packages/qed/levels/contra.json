      "tests": [
        {
          "goal": "(A → B) → (¬B → ¬A)"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Exam",
          "B": "Study"
        }
      ],
      "hint": [
        "@level.contra.tasks.contra.hint.0",
        "@level.contra.tasks.contra.hint.1"
      ],
      "solution": [
        "f = impI[A=\"A -> B\"](body: g) {",
        "  body {",
        "    g = impI[A=\"~B\"](body: t) {",
        "      body {",
        "        t = chain(f.body, g.body)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ],
