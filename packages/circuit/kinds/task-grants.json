{
  "extends": "task",
  "fields": {
    "tray": {
      "type": "name",
      "kind": "circuit/tray",
      "optional": true
    },
    "featuredParts": {
      "type": "list",
      "of": {
        "type": "ref",
        "kind": "primitive",
        "reference": "circuit/part"
      },
      "optional": true
    },
    "publishes": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": {
          "part": {
            "type": "ref",
            "kind": "primitive",
            "reference": "circuit/part"
          },
          "variant": {
            "type": "str",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      },
      "optional": true
    }
  },
  "declares": "package",
  "overrides": {
    "package": [
      "*"
    ],
    "game": [
      "$text"
    ]
  }
}
