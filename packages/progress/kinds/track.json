{
  "folder": "progress-tracks",
  "declares": ["package", "game"],
  "overrides": {
    "package": ["*"],
    "game": ["$text"]
  },
  "schema": {
    "type": "obj",
    "fields": {
      "title": { "type": "text" },
      "kind": { "type": "str", "reference": "kind" },
      "target": { "type": "str", "reference": "$kind" },
      "stages": {
        "type": "list",
        "min": 1,
        "of": {
          "type": "obj",
          "fields": {
            "id": { "type": "str", "pattern": "^[a-z][a-z0-9-]*$" },
            "title": { "type": "text", "optional": true },
            "afterLevel": { "type": "level", "optional": true },
            "afterTask": { "type": "task", "optional": true }
          }
        }
      }
    }
  },
  "studio": {
    "name": "@kind.track.name",
    "icon": "ListOrdered"
  }
}
